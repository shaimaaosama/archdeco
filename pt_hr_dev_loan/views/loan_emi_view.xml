<odoo>



    
	<record id="view_loan_emi_form" model="ir.ui.view">
		<field name="name">view.loan.emi.form</field>
		<field name="model">installment.line</field>
		<field name="arch" type="xml">
			<form string="Installment Form">
				<sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="loan_id" readonly="1" />
<!--                            <field name="paid" />-->
                            <field name="interest" readonly="1" invisible="1"/>
                            <field name="installment_amt" readonly="1"  />
                            <field name="payslip_id" readonly="1"  />
                            <field name="payroll_paid" readonly="0"  />

                        </group>
                        <group>
                             <field name="employee_id" readonly="1"  />
                             <field name="date" readonly="1"  />
                             <field name="amount" readonly="1"  />
                             <field name="ins_interest" readonly="1" invisible="1" />
                             <field name="total_installment" readonly="1"  />
                             <field name="is_skip" readonly="1"  />
                        </group>
                    </group>
				</sheet>
			</form>
		</field>
	</record>
    <record id="installment_line_tree" model="ir.ui.view">
        <field name="name">installment.line.tree</field>
        <field name="model">installment.line</field>
        <field name="arch" type="xml">
            <list string="Loan Installment">
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="interest" invisible="1"/>
                <field name="installment_amt"/>
                <field name="ins_interest" invisible="1"/>
                <field name="total_installment" invisible="1"/>
            </list>
        </field>
    </record>
    
    
    <record model="ir.actions.act_window" id="action_installment_line">
        <field name="name">Installment Loan</field>
        <field name="res_model">installment.line</field>
        <!--<field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
          </p>
        </field>
    </record>
    
    <record id="ir_cron_update_installment_employee_id" model="ir.cron">
        <field name="name">Update Installment Employee ID</field>
        <field name="model_id" ref="model_installment_line"/>
        <field name="state">code</field>
        <field name="code">model.update_employee_ids_from_loan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_fix_duplicate_installment_names" model="ir.cron">
            <field name="name">Fix Duplicate Installment Names</field>
            <field name="model_id" ref="model_installment_line"/>
            <field name="state">code</field>
            <field name="code">model.fix_duplicate_names()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
    </record>


</odoo>
