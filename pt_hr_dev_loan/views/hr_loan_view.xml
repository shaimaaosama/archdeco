<odoo>
    <record id="dev_account_payment_loan_inherit_form" model="ir.ui.view">
        <field name="name">dev.account.payment.loan.inherite.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="employee_loan_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_loan_form" model="ir.ui.view">
        <field name="name">view.employee.loan.form</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form string="Employee Loan">
                <header>
                    <button name="compute_installment" invisible="state != 'draft'" string="Compute Installment"
                            class="btn-primary" type="object" groups="base.group_user"/>

                    <button name="action_send_request" invisible="state != 'draft'" string="Submit Request"
                            class="btn-primary" type="object" groups="base.group_user"/>

                    <button name="dep_manager_approval_loan" invisible="state != 'request'" string="Approve Request"
                            class="btn-primary"
                            type="object" groups="pt_hr_dev_loan.group_department_manager"/>
                    <button name="dep_manager_reject_loan" invisible="state != 'request'" string="Reject Request"
                            class="btn-primary"
                            type="object" groups="pt_hr_dev_loan.group_department_manager"/>

                    <button name="cancel_loan" invisible="state != 'request'" string="Cancel" type="object"
                            groups="base.group_user"/>


                    <button name="hr_manager_approval_loan" invisible="state != 'dep_approval'" string="Confirm"
                            class="btn-primary"
                            type="object" groups="hr.group_hr_manager"/>
                    <button name="hr_manager_reject_loan" invisible="state != 'dep_approval'" string="Reject"
                            class="btn-primary"
                            type="object" groups="hr.group_hr_manager"/>

                    <button name="paid_loan" invisible="state != 'hr_approval'" string="Create Accrual Entry"
                            class="btn-primary"
                            type="object"
                            groups="account.group_account_manager"/>

                    <button name="loan_payment" string="Loan Payment" class="btn-primary"
                            type="object"
                            invisible="is_payment == True or state != 'financial_approval'"
                            groups="account.group_account_manager,hr.group_hr_manager"

                    />

                    <button name="set_to_paid" string="Paid" class="btn-primary"
                            type="object"
                            invisible="is_payment != True or state != 'financial_approval'"
                            groups="account.group_account_manager,hr.group_hr_manager"

                    />

                    <button name="set_to_draft" invisible="state != 'cancel'" string="Set to Draft" class="btn-primary"
                            type="object"
                            groups="base.group_user"/>

                    <button name="action_close_loan" string="Close Loan" class="btn-primary" type="object"
                            groups="hr.group_hr_manager"
                            invisible="is_close != True"

                    />

                    <button name="action_done_loan" invisible="state != 'paid'" string="Done" class="btn-primary"
                            type="object"
                            groups="hr.group_hr_manager"/>

                    <button name='send_loan_detail' invisible="0" string='Send Mail' class="btn-primary"
                            type="object"
                            groups="hr.group_hr_user"/>

                    <button type="object" name="cash_payment" string="Payment Cash"
                            class="btn-primary" invisible="state != 'done'"/>


                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,request,dep_approval,hr_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <b>
                            <button name="view_journal_entry" type="object" class="oe_stat_button"
                                    icon="fa-external-link" string="Journal Entry" groups="hr.group_hr_manager"
                                    invisible="state not in ['done','financial_approval','paid']"
                            />
                        </b>
                        <button type="object"
                                name="action_view_loan_installment"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="installment_count == 0"
                        >
                            <field name="installment_count" string="Installment" widget="statinfo"/>
                        </button>

                        <button
                                name="view_payments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar"
                                invisible="payments_count == 0">

                            <field name="payments_count" string="Payments" widget="statinfo"/>
                        </button>

                    </div>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>

                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft' "/>
                            <field name="department_id" readonly="state != 'draft' "/>
                            <field name="manager_id" readonly="state != 'draft' "/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="job_id" readonly="state != 'draft' "/>
                            <field name="loan_url" invisible="1" column_invisible="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="hr_manager_id" invisible="1" column_invisible="1"/>
                            <field name="is_close" invisible="1" column_invisible="1"/>
                            <field name="move_id" invisible="1" column_invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_apply_interest" invisible="1" column_invisible="1"/>
                            <field name="payment_method" readonly="state != 'draft' "/>
                            <field name="loan_amount" readonly="state not in ['draft','financial_approval']"/>
                            <field name="interest_amount" invisible="is_apply_interest != True"/>
                            <field name="paid_amount"/>
                            <field name="remaing_amount"/>
                        </group>
                        <group>
                            <field name="loan_type_id" readonly="state != 'draft' "/>
                            <field name="start_date" readonly="state != 'draft' "/>
                            <field name="term" readonly="state != 'draft' "/>
                            <field name="end_date"/>
                            <field name="interest_rate"
                                   readonly="state != 'draft'"
                                   invisible="is_apply_interest != True"
                            />
                            <field name="interest_type"
                                   readonly="state != 'draft'"
                                   invisible="is_apply_interest != True"
                            />
                            <field name="paid_by_ids" widget="many2many_tags"/>
                            <field name="is_payment" invisible="1" readonly="0"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="installment_amount"/>
                        </group>
                        <group>

                        </group>
                    </group>

                    <notebook>
                        <page string="Reason">
                            <br/>
                            <field name="notes" readonly="state != 'draft' "/>
                        </page>
                        <page string="Installment">
                            <button name='%(pt_hr_dev_loan.action_gs_update_installment_amount)d' icon="fa-arrow-right"
                                    type="action" string="Update"/>
                            <br/>
                            <field name="installment_lines" readonly="0" >
                                <list string="Installment" decoration-success="is_paid == True" delete="false"
                                      decoration-muted="is_skip == True">
                                    <field name="name"/>
                                    <field name="payroll_paid"/>
                                    <field name="date"/>
                                    <field name="amount" sum="amount" invisible="1" column_invisible="1"/>
                                    <field name="interest" sum="interest" invisible="1" column_invisible="1"/>
                                    <field name="installment_amt" sum="installment_amt" column_invisible="1"/>
                                    <field name="ins_interest" sum="ins_interest" invisible="1" column_invisible="1"/>
                                    <field name="total_installment" sum="total_installment"/>
                                    <field name="is_paid" invisible="1" column_invisible="1"/>
                                    <field name="is_skip" invisible="1" column_invisible="1"/>
                                    <button type="object" name="action_view_payslip" string="Payslip"
                                            class="btn-primary"
                                            invisible="is_paid != True"
                                            groups="hr.group_hr_manager"/>
                                    <button name="action_view_journal_entry"
                                            type="object"
                                            string="Cash"
                                            invisible="not journal_entry_id"
                                            class="btn-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Document">
                            <field name="loan_document_line_ids" mode="kanban"
                                   context="{'default_employee_id':employee_id }">
                                <!--                                   context="{'default_loan_id': active_id,'default_employee_id':employee_id }">-->
                                <!--               ######?????                -->
                                <kanban>
                                    <field name="name"/>
                                    <field name="document"/>
                                    <field name="employee_id"/>
                                    <field name="date"/>


                                    <templates>

                                        <t t-name="card">
                                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                                <div class="oe_kanban_details">

                                                    <strong>
                                                        <h3>
                                                            <field name="sequ_name"/>
                                                        </h3>
                                                    </strong>
                                                    <ul>
                                                        <li>
                                                            <span style="color: #800000">Name :</span>
                                                            <field name="name"/>
                                                        </li>
                                                        <li>
                                                            <span style="color: #800000">Date:</span>
                                                            <field name="date"/>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>

                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_employee_loan_tree" model="ir.ui.view">
        <field name="name">view.employee.loan.tree</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <list string="Employee Loan">
                <field name="name"/>
                <field name="registration_number2"/>
                <field name="employee_id"/>
                <field name="lone_report_state_ids" widget="many2many_tags" optional="hidden"/>
                <field name="loan_amount"/>
                <field name="start_date"/>
                <field name="loan_type_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_employee_loan_filter" model="ir.ui.view">
        <field name="name">employee.loan.select</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <search string="Search Employee Loan">
                <field name="employee_id" operator="child_of"/>
                <field name="user_id"/>
                <field name="name" string="Loan" filter_domain="[('name','ilike',self)]"/>
                <filter name='draft' string="Draft" domain="[('state','=','draft')]" help="Draft Loan"/>
                <filter name='done' string="Done" domain="[('state','=','done')]" help="Done Loan"/>
                <filter name='financial_approval' string="Financial Approval"
                        domain="[('state','=','financial_approval')]" help="Financial Approval"/>
                <filter name='paid' string="Paid" domain="[('state','=','paid')]" help="Paid Loan"/>
                <filter name='hr_approval' string="HR Approval" domain="[('state','=','hr_approval')]"/>
                <field name="loan_type_id"/>

                <!--                <field name="employee_id"/>-->
                <group expand="0" string="Group By">
                    <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                    <filter string="Manager" name="manager_id" context="{'group_by':'manager_id'}"/>
                    <filter string="Loan type" name="type" context="{'group_by':'loan_type_id'}"/>
                    <filter string="States" name="state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_view_all_loan" model="ir.actions.act_window">
        <field name="name">View Loan</field>
        <field name="res_model">employee.loan</field>
        <field name="type">ir.actions.act_window</field>
        <!--<field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="domain"></field>
        <field name="context">{ }
        </field>
        <field name="search_view_id" ref="view_employee_loan_filter"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click here to create a new Loan.
            </p>
        </field>
    </record>

