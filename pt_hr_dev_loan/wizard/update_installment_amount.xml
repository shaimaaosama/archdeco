<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gs_update_installment_amount_form" model="ir.ui.view">
        <field name="name">view.gs.update.installment.amount.form</field>
        <field name="model">gs.update.installment.amount</field>
        <field name="arch" type="xml">
            <form string="Import Loan">
            	<group>
                    <group>
                        <field name="type" required="1"/>
                        <field name="employee_loan_id" invisible="1"/>
                        <field name="installment_line_ids" widget="many2many_tags" invisible="1"/>
                        <field name="installment_line_from_ids" widget="many2many_tags" domain="[('id', 'in', installment_line_ids)]" required="1"/>
                        <field name="installment_amt_now" readonly="1"/>
                        <field name="amount" readonly="0"/>
                    </group>
                    <group>
                        <field name="installment_line_to_id"  domain="[('id', 'in', installment_line_ids)]" invisible="type != 'current_installment'" required="1"/>
                        <field name="date_to" invisible="type != 'new_installment'" type="type != 'new_installment'" />
                        <field name="installment_amt_to" readonly="1" force_save="1" invisible="type != 'current_installment'" />
                        <field name="amount_update" readonly="1" force_save="1"/>
                    </group>
                </group>
                <footer>
                	<button class="oe_highlight" name="action_update_installment_amount" string="Update" type="object" />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record> 
    
    <record id="action_gs_update_installment_amount" model="ir.actions.act_window">
        <field name="name">Import Loan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.update.installment.amount</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_employee_loan_id': active_id}</field>
    </record>
    

    
</odoo>
