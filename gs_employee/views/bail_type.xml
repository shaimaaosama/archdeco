<odoo>

    <record id="gs_bail_type_view_tree" model="ir.ui.view">
        <field name="name">gs.bail.type.view.tree</field>
        <field name="model">gs.bail.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="gs_bail_type_view_form" model="ir.ui.view">
        <field name="name">gs.bail.type.view.form</field>
        <field name="model">gs.bail.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_bail_type_action" model="ir.actions.act_window">
        <field name="name">Bail Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.bail.type</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>