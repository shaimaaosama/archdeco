<odoo>
    <data>
        <record id="account_move_view_inherit_v" model="ir.ui.view">
            <field name="name">account.move.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="attributes">
                    <attribute name="groups">product_create_group.product_open_group</attribute>

                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="after">
                    <field name="product_id" groups="!product_create_group.product_open_group"
                           options="{'no_open':True,  'no_create_edit': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>