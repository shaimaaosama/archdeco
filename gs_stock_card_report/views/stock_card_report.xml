    <record id="stock_card_report" model="ir.actions.report">
        <field name="name">Stock Card Report</field>
        <field name="model">gs.stock.card.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gs_stock_card_report.stock_card_report_view</field>
        <field name="report_file">gs_stock_card_report.stock_card_report_view</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="gs_stock_card_report.paperformat_gs_stock_card_report"/>
        <field name="binding_type">report</field>
    </record>


