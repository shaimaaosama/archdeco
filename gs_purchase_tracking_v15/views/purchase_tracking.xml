<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gs_stock_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="tracking_id" readonly="1"/>
            </xpath></field>
    </record>
    <record id="gs_purchase_tracking_view_search" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.view.search</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_ref"/>
                <field filter_domain="[('order_line_tracking.product_id.name','ilike',self)]" name="order_line_tracking" string="product name"/>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="date_order"/>
            </search></field>
    </record>
    <record id="gs_purchase_tracking_view_tree" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.view.tree</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="partner_ref" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="date_order" optional="show"/>
                <field name="amount_untaxed" optional="hide" string="Untaxed" sum="Total Untaxed amount" widget="monetary"/>
                <field name="amount_total" optional="show" sum="Total amount" widget="monetary"/>
                <field name="origin" optional="hide"/>
                <field name="payment_term_id" optional="hide"/>
                <field name="incoterm_id" optional="hide"/>
                <field name="state" optional="hide"/>
            </list></field>
    </record>
    <record id="gs_purchase_tracking_view_form" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.view.form</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="oe_highlight" invisible="is_submit != True or state != 'draft'" name="action_submit" string="Submit" type="object"/>
                    <button class="oe_highlight" invisible="is_approve != True or state != 'submit'" name="action_approved" string="Approve" type="object"/>
                    <button invisible="is_cancel != True or state not in ['draft', 'submit']" name="action_cancel" string="Cancel" type="object"/>
                    <button invisible="is_draft != True or state not in ['cancel', 'locked']" name="action_draft" string="Set to Draft" type="object"/>
                    <button invisible="state in ['draft', 'locked'] or is_lock_bol != True" name="action_lock" string="Lock" type="object"/>
                    <button invisible="state != 'locked' or is_unlock_bol != True" name="action_unlock" string="Unlock" type="object"/>
                    <button class="oe_highlight" invisible="is_crate_receipt != True or is_finish == True or state != 'approved'" name="%(gs_receipt_button_wizard_action)d" string="Create Receipt" type="action"/>
                    <!-- attrs="{'invisible':[('picking_id','!=', False)]}"-->
                    <button class="oe_highlight" invisible="is_create_bill_bol != True or is_create_bill != True or state != 'approved'" name="action_create_bill" string="Create Bill" type="object"/>
                    <field name="state" statusbar_visible="draft,submit,approved" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-edit" invisible="invoice_count == 0" name="open_gs_invoice" type="object">
                            <field name="invoice_count" string="Invoices" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" groups="stock.group_stock_user" icon="fa-truck" invisible="incoming_picking_count == 0" name="action_view_picking" type="object">
                            <field help="Incoming Shipments" name="incoming_picking_count" string="Receipt" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" groups="stock.group_stock_user" icon="fa-search" invisible="shipment_count == 0" name="action_view_shipment" type="object">
                            <field name="shipment_count" string="Shipment Tracking" widget="statinfo"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_ref"/>
                            <field name="currency_id"/>
                            <field invisible="1" name="invoice_id" readonly="0" widget="many2many_tags"/>
                            <field invisible="1" name="picking_id"/>
                            <field invisible="1" name="is_finish"/>
                            <field invisible="1" name="is_cancel"/>
                            <field invisible="1" name="is_draft"/>
                            <field invisible="1" name="is_approve"/>
                            <field invisible="1" name="is_submit"/>
                            <field invisible="1" name="is_crate_receipt"/>
                            <field invisible="1" name="is_create_bill"/>
                            <field invisible="1" name="is_create_bill_bol"/>
                            <field invisible="1" name="is_lock_bol"/>
                            <field invisible="1" name="is_unlock_bol"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_planned"/>
                            <field name="picking_type_id"/>
                            <field invisible="1" name="amount_untaxed"/>
                            <field invisible="1" name="amount_tax"/>
                            <field invisible="1" name="amount_total"/>
                            <field invisible="1" name="tax_country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="order_line_tracking" widget="section_and_note_one2many">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create context="{'default_display_type': 'line_section'}" name="add_section_control" string="Add a section"/>
                                        <create context="{'default_display_type': 'line_note'}" name="add_note_control" string="Add a note"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field invisible="1" name="tracking_id"/>
                                    <field invisible="1" name="partner_id"/>
                                    <field invisible="1" name="product_type"/>
                                    <field name="product_id"/>
                                    <field name="name" readonly="0"/>
                                    <field name="date_planned" optional="hide" required="0"/>
                                    <field name="product_qty" optional="show"/>
                                    <field name="qty_received" optional="show"/>
                                    <field name="qty_invoiced" optional="show"/>
                                    <field invisible="1" name="qty"/>
                                    <field invisible="1" name="shipment_bill"/>
                                    <field name="shipment" optional="show"/>
                                    <field name="under_shipment" optional="show" readonly="1"/>
                                    <field invisible="1" name="sh_is_secondary_unit"/>
                                    <field name="sh_sec_qty" optional="hide"/>
                                    <field name="sh_sec_uom" optional="hide"/>
                                    <field invisible="1" name="category_id"/>
                                    <field invisible="1" name="currency_id"/>
                                    <field invisible="1" name="display_type"/>
                                    <field invisible="1" name="product_uom_category_id"/>
                                    <field force_save="1" name="product_uom" optional="hide" readonly="0" required="0" string="UoM"/>
                                    <field name="price_unit" optional="show"/>
                                    <field context="{'default_type_tax_use': 'purchase', 'search_view_ref': 'account.account_tax_view_search'}" domain="[('type_tax_use','=','purchase'), ('company_id', '=', parent.company_id), ('country_id', '=', parent.tax_country_id)]" name="taxes_id" optional="show" options="{'no_create': True}" widget="many2many_tags"/>
                                    <field name="price_subtotal" optional="show" widget="monetary"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field colspan="2" name="tax_totals_json" nolabel="1" widget="account-tax-totals-field" />
                            </group>
                        </page>
                        <page string="Other Information">
                            <group>
                                <group>
                                    <field name="city"/>
                                    <field name="port"/>
                                    <field name="user_id"/>
                                    <field name="company_id"/>
                                    <field name="origin"/>
                                </group>
                                <group>
                                    <field name="payment_term_id"/>
                                    <field name="incoterm_id"/>
                                    <field force_save="1" groups="analytic.group_analytic_accounting" name="analytic_account_id"/>
<!--                                    <field force_save="1" groups="analytic.group_analytic_tags" name="analytic_tag_id"/>-->
                                </group>
                            </group>
                        </page>
                        <page string="Project Information">
                            <group string="Commercial Terms:">
                                <group>
                                    <field name="price_basis"/>
                                    <field name="offer_validity"/>
                                    <field name="work_period"/>
                                    <field name="bank_detials"/>
                                    <field name="payment_terms"/>
                                    <field name="special_conditions"/>
                                    <field name="project_location"/>
                                </group>
                                <group string="Warranty">
                                    <field name="matrial"/>
                                    <field name="install"/>
                                </group>
                                <group>
                                    <field name="project_location"/>
                                    <field name="project"/>
                                    <field name="client_order_ref"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
<!--                <div class="oe_chatter">-->
<!--                    <field groups="base.group_user" name="message_follower_ids" widget="mail_followers"/>-->
<!--                    <field name="activity_ids" widget="mail_activity"/>-->
<!--                    <field name="message_ids" widget="mail_thread"/>-->
<!--                </div>-->
            </form></field>
    </record>
    <record id="gs_purchase_tracking_view_kanban" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.kanban</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <kanban class="o_broker_profile_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_ref"/>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="date_order"/>
                <field name="amount_untaxed"/>
                <field name="amount_total"/>
                <field name="origin"/>
                <field name="payment_term_id"/>
                <field name="incoterm_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <h3>
                                    <field name="name"/>
                                </h3>
                                <ul>
                                    <li>
                                        <b>
                                            Partner:
                                        </b>
                                        <field name="partner_id"/>
                                    </li>
                                    <li>
                                        <b>
                                            Order Deadline:
                                        </b>
                                        <field name="date_order"/>
                                    </li>
                                    <li>
                                        <b>
                                            Deliver To:
                                        </b>
                                        <field name="picking_type_id"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom h5 mt-2 mb-0">
                                    <div class="d-flex flex-grow-1 text-600 mt-1" id="utm_statistics"/>
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill float-right mt4 mr16" style="border-color:#5e75c8;background: #5e75c8;color: whitesmoke;">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge badge-pill float-right mt4 mr16" style="background: #00A09D;color: whitesmoke;">
                                            <field name="user_id"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge badge-pill float-right mt4 mr16" style="background: #00A09D;color: whitesmoke;">
                                            Amount:
                                            <field name="amount_total"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban></field>
    </record>
    <record id="gs_purchase_tracking_report_graph" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.report.graph</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <graph sample="1" string="Exterior Purchase">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="picking_type_id"/>
                <field name="amount_total" type="measure"/>
            </graph></field>
    </record>
    <record id="view_gs_purchase_tracking_pivot" model="ir.ui.view">
        <field name="name">gs.purchase.tracking.pivot</field>
        <field name="model">gs.purchase.tracking</field>
        <field name="arch" type="xml">
            <pivot disable_linking="True" display_quantity="true" string="Exterior Purchase Order Analysis">
                <field name="name" type="row"/>
            </pivot></field>
    </record>
    <record id="gs_purchase_tracking_action" model="ir.actions.act_window">
        <field name="name">Exterior Purchase Order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.purchase.tracking</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>
    <menuitem id="menu_gs_tracking" name="Exterior Purchase" sequence="5" web_icon="gs_purchase_tracking_v15,static/description/TEST.png"/>
    <menuitem id="menu_gs_purchase_tracking" name="Exterior Purchase" parent="gs_purchase_tracking_v15.menu_gs_tracking" sequence="1"/>
    <menuitem action="gs_purchase_tracking_action" id="sub_gs_purchase_tracking" name="Exterior Purchase Order" parent="gs_purchase_tracking_v15.menu_gs_purchase_tracking" sequence="1"/>
</odoo>
