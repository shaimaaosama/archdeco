<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_faces" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Face Recognition">
                    <group>
                        <group>
                            <field name="face_recognition_enabled" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="user_faces" 
                            class="o_website_sale_image_list" 
                            context="{'default_name': name}" 
                            mode="kanban" 
                            options="{'create_text':'Add'}" nolabel="1"/>
                </page>
                <page string="Allowed Devices">
                    <group>
                        <group>
                            <field name="device_check_enabled" widget="boolean_toggle"/>
                            <field name="allow_next_device" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="allowed_devices" 
                            context="{'default_employee_id': id}" 
                            mode="list">
                        <list>
                            <field name="name"/>
                            <field name="mac_address"/>
                            <field name="device_type"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="last_used"/>
                            <field name="notes"/>
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="mac_address"/>
                                    <field name="device_type"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="employee_id" invisible="1"/>
                                    <field name="last_used" readonly="1"/>
                                    <field name="notes"/>
                                </group>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>            
        </field>
    </record>

    <record id="view_hr_employee_faces_form" model="ir.ui.view">
        <field name="name">hr.employee.faces.view.form</field>
        <field name="model">hr.employee.faces</field>
        <field name="arch" type="xml">
            <form string="Face Recognition">
                <div class="row o_website_sale_image_modal">
                    <div class="col-md-6 col-xl-5">
                        <label for="name" string="Name"/>
                        <h2><field name="name" placeholder="Name"/></h2>
                        <field name="descriptor" invisible="1"/>
                        <field name="has_descriptor" invisible="1"/>

                        <div class="alert alert-info" colspan="4" role="alert" invisible="not has_descriptor">
                            <i class="fa fa-smile-o"/>                            
                            Face Descriptor has been loaded.
                        </div>

                        <div class="alert alert-danger" colspan="4" role="alert" invisible="has_descriptor">
                            <i class="fa fa-frown-o"/>                            
                            Face Descriptor is not loaded, Try again / Load Image.
                        </div>

                    </div>                    
                    <div class="col-md-6 col-xl-7 text-center o_website_sale_image_modal_container">
                        <div class="row">
                            <div class="col" id="face_image">
                                <field name="image" widget="image"/>                                
                            </div>                            
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_faces_kanban" model="ir.ui.view">
        <field name="name">hr.employee.faces.view.kanban</field>
        <field name="model">hr.employee.faces</field>
        <field name="arch" type="xml">
            <kanban string="Face Recognition">                
                <field name="name"/>
                <field name="image"/>
                <field name="id"/>
                <field name="has_descriptor"/>
                <templates>
                    <t t-name="card">
                        <div class="card oe_kanban_global_click p-0">
                            <div class="o_squared_image">
                                <t t-if="record.image.raw_value">
                                    <img class="card-img-top" t-attf-src="/web/image?model=hr.employee.faces&amp;field=image&amp;id=#{record.id.raw_value}" t-att-alt="record.name.value"/>
                                </t>
                                <t t-else="">
                                    <img class="card-img-top" src="/web/static/img/placeholder.png" t-att-alt="record.name.value"/>
                                </t>
                            </div>
                            <div class="card-body p-0">
                                <h4 class="card-title p-2 m-0">
                                    <small>
                                        <span class="text-truncate d-inline-block" style="max-width: 70%;" t-esc="record.name.value"/>
                                        <span t-attf-class="fa fa-smile-o" t-if="record.has_descriptor.raw_value == true" title="Face Descriptor Generated"/>
                                        <span t-attf-class="fa fa-frown-o" t-if="record.has_descriptor.raw_value == false" title="No Face Descriptor"/>
                                    </small>
                                </h4>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
</odoo>
