<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_menu_hr_attendances" name="Portal layout : hr attendances menu entries" inherit_id="portal.portal_breadcrumbs" priority="23">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

            <li t-if="page_name == 'hr_attendances' or hr_attendance" t-attf-class="breadcrumb-item #{'active ' if not hr_attendance else ''}">
                <a t-if="hr_attendance" t-attf-href="/my/hr_attendances?{{ keep_query() }}">Attendances</a>
                <t t-else="">Attendances</t>
            </li>

            <li t-if="hr_attendance" class="breadcrumb-item active">
                <span t-field="hr_attendance.employee_id.name"/>
            </li>

            <li t-if="page_name == 'create_new_attendance' or create_new_attendance" t-attf-class="breadcrumb-item #{'active ' if not hr_attendance else ''}">
                <a t-attf-href="/my/hr_attendances?{{ keep_query() }}">Attendances</a>
                <li class="breadcrumb-item">
                    <span>Check In or Check Out</span>
                </li>
            </li>
        </xpath>
    </template>

    <template id="portal_docs_attendance_entry" name="My Portal Attendance Docs Entry">
        <div t-att-class="'o_portal_index_card ' +  ('' if config_card else 'd-none ') + ('col-12 order-0' if show_count else 'col-md-6 order-2')">
            <a t-att-href="url" t-att-title="title" t-attf-class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 h-100 rounded text-decoration-none text-reset #{bg_color if bg_color else 'text-bg-light'}">
                <div t-if="icon" class="o_portal_icon align-self-start">
                    <img t-attf-src="#{icon}"/>
                </div>
                <div>
                    <h5 t-attf-class="mt-0 mb-1 #{'d-flex gap-2' if placeholder_count or count else ''}">
                        <t t-out="count"/>
                        <span t-if="placeholder_count" t-att-class="'' if show_count else 'd-none'" t-att-data-placeholder_count="placeholder_count"/>
                        <span t-out="title"/>
                    </h5>
                    <p class="m-0 text-600">
                        <t t-out="text"/>
                    </p>
                </div>

                <div>
                    <t t-if="hr_attendance_state == 'checked_in'">
                        <button class="fa fa-sign-in o_hr_attendance_sign_in_out_icon btn-secondary  ml-1" 
                            title="Check Out"/>
                    </t>
                    <t t-else="">
                        <button class="fa fa-sign-out o_hr_attendance_sign_in_out_icon btn-secondary btn-fill-warning ml-1" 
                            title="Check In"/>
                    </t>
                </div>

            </a>
        </div>
    </template> 

    <template id="portal_my_home_hr_attendances" name="Show Attendances" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="pt_attendance_portal.portal_docs_attendance_entry">
                <t t-set="icon" t-value="'/pt_attendance_portal/static/src/img/attendance.svg'"/>
                <t t-set="title">Attendances</t>
                <t t-set="text">Follow your Attendances</t>
                <t t-set="url" t-value="'/my/hr_attendances'"/>
                <t t-set="placeholder_count" t-value="'hr_attendance_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_hr_attendances" name="My Attendances">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">HR Attendances</t>
                <div class="form-inline ml-lg-4 pl2" t-if="request.env.user.employee_id" style="margin-left: 8px;">
                    <a class="btn btn-primary btn-md" name='create_new_hr_attendance' title="Create New Attendance" href="/my/hr_attendances/create_new">
                        <i class="fa fa-sign-in"/> Check In / Out
                    </a>
                </div>
            </t>

            <t t-if="not hr_attendances">
                <div class="alert alert-warning mt8" role="alert">
                    There are currently no HR Attendances for your account.
                </div>
            </t>

            <t t-if="hr_attendances" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Attendance #</th>
                        <th class="text-left">Check In</th>
                        <th class="text-left">Check Out</th>
                        <th class="text-left">Check In Photo</th>
                        <th class="text-left">Check Out Photo</th>                        
                        <th class="text-left">Check In Map</th>
                        <th class="text-left">Check Out Map</th>
                    </tr>
                </thead>
                <t t-foreach="hr_attendances" t-as="attendance">
                    <tr>
                        <td>
                            <a t-att-href="attendance.get_portal_url()">
                                <t t-esc="attendance.employee_id.name"/>
                            </a>
                        </td>
                        <td class="text-left">
                            <span t-field="attendance.check_in"/>
                        </td>
                        <td class="text-left">
                            <span t-field="attendance.check_out"/>
                        </td>
                        <td class="text-left">
                            <t t-if="attendance.check_in_photo">
                                <img t-att-src="image_data_uri(attendance.check_in_photo)" style="max-height: 40px; max-width: 40px;"/>
                            </t> 
                        </td>
                        <td class="text-left">
                            <t t-if="attendance.check_out_photo">
                                <img t-att-src="image_data_uri(attendance.check_out_photo)" style="max-height: 40px; max-width: 40px;"/>
                            </t> 
                        </td>
                        <td class="text-left">
                            <t t-set="map_in_link" t-value="attendance.check_in_location_link"/>
                            <span t-if="map_in_link">
                                <a t-att-href="map_in_link" target="_blank"><span t-esc="map_in_link"/></a>
                            </span> 
                        </td>
                        <td class="text-left">
                            <t t-set="map_out_link" t-value="attendance.check_out_location_link"/>
                            <span t-if="map_out_link">
                                <a t-att-href="map_out_link" target="_blank"><span t-esc="map_out_link"/></a>
                            </span> 
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_hr_attendance" name="My Attendances">
        <t t-call="portal.portal_layout">
            <div class="row no-gutters mb-3">
                <div class="col-12">
                    <h5 class="d-flex mb-1 mb-md-0 row">
                        <span t-field="hr_attendance.employee_id.name" class="col-9  col-md-9 text-truncate"/>
                        <small class="col-1 col-md-1 text-muted d-none d-md-inline mt-1"> (#<span t-field="hr_attendance.id"/>)</small>
                    </h5>
                </div>
            </div>
                    <div class="row mb-4">
                        <div class="col-9 col-md-9 mb-1">
                            <strong>Create Date:</strong>
                            <span t-field="hr_attendance.create_date" t-options='{"widget": "date"}'/>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12 col-md-6 pb-2">
                            <strong>Employee</strong>
                            <div class="row">
                                <div class="col flex-grow-0 pr-3">
                                    <img t-if="hr_attendance.employee_id.image_1024" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(hr_attendance.employee_id.image_1024)" alt="Contact" style="height: 50px;"/>
                                    <img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Contact" style="height: 50px;"/>
                                </div>
                                <div class="col pl-md-0">
                                    <div t-field="hr_attendance.employee_id.name"/>
                                    <div t-if="hr_attendance.employee_id.work_email">
                                        <i class="fa fa-phone fa-fw" role="img" aria-label="Phone" title="Phone"></i>
                                        <span t-field="hr_attendance.employee_id.work_email"/>
                                    </div>
                                    <div t-if="hr_attendance.employee_id.work_phone">
                                        <i class="fa fa-envelope fa-fw" role="img" aria-label="Phone" title="Phone"></i>
                                        <span t-field="hr_attendance.employee_id.work_phone"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-1">
                        <div class="col-12 col-md-12 mb-1">
                            <strong>Check In:</strong>
                            <span t-field="hr_attendance.check_in"/>
                        </div>
                    </div>

                    <div class="row mb-1">
                        <div class="col-12 col-md-12 mb-1">
                            <strong>Check Out:</strong>
                            <span t-field="hr_attendance.check_out"/>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <div class="col-12 col-md-12 mb-1">
                            <strong>Worked Hours:</strong>
                            <span t-field="hr_attendance.worked_hours"/>
                        </div>
                    </div>

                    <div class="row mb-1 mt8">
                        <div class="col-6 col-md-6 pb-2">
                            <h4>Check-in Location</h4>
                            <div class="row">
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-in Latitude:</strong>
                                    <span t-field="hr_attendance.check_in_latitude"/>
                                </div>
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-in Longitude:</strong>
                                    <span t-field="hr_attendance.check_in_longitude"/>
                                </div>
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-in Reason:</strong>
                                    <span t-field="hr_attendance.check_in_reason"/>
                                </div>    
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-in Geofences:</strong>
                                    <span t-field="hr_attendance.check_in_geofence_ids"/>
                                </div>   
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-In IP Address:</strong>
                                    <span t-field="hr_attendance.check_in_ipaddress"/>
                                </div>  
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-in Map:</strong>
                                    <t t-set="map_in_link" t-value="hr_attendance.check_in_location_link"/>
                                    <span t-if="map_in_link">
                                        <a t-att-href="map_in_link" target="_blank"><span t-esc="map_in_link"/></a>
                                    </span> 
                                </div>                           
                            </div>
                        </div>
                        <div class="col-6 col-md-6 pb-2">
                            <h4>Check-Out Location</h4>
                            <div class="row">
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-out  Latitude:</strong>
                                    <span t-field="hr_attendance.check_out_latitude"/>
                                </div>
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-out  Longitude:</strong>
                                    <span t-field="hr_attendance.check_out_longitude"/>
                                </div>
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-out Reason:</strong>
                                    <span t-field="hr_attendance.check_out_reason"/>
                                </div> 
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-Out Geofences:</strong>
                                    <span t-field="hr_attendance.check_out_geofence_ids"/>
                                </div>  
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-out IP Address:</strong>
                                    <span t-field="hr_attendance.check_out_ipaddress"/>
                                </div>  
                                <div class="col-12 col-md-12 mb-1">
                                    <strong>Check-out Map:</strong>
                                    <t t-set="map_out_link" t-value="hr_attendance.check_out_location_link"/>
                                    <span t-if="map_out_link">
                                        <a t-att-href="map_out_link" target="_blank"><span t-esc="map_out_link"/></a>
                                    </span> 
                                </div>  
                            </div>
                        </div>
                    </div>

                    <div class="row mb-1 mt8">
                        <div class="col-6 col-md-6 pb-2">
                            <h4>Check-in Photo</h4>
                            <div class="row">
                                <div class="col-12 col-md-12 mb-1">     
                                    <t t-if="hr_attendance.check_in_photo">
                                        <img t-att-src="image_data_uri(hr_attendance.check_in_photo)" style="max-height: 6rem; max-width: 100%;"/>
                                    </t>                                                       
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-6 pb-2">
                            <h4>Check-out Photo</h4>
                            <div class="row">
                                <div class="col-12 col-md-12 mb-1">     
                                    <t t-if="hr_attendance.check_out_photo">
                                        <img t-att-src="image_data_uri(hr_attendance.check_out_photo)" style="max-height: 6rem; max-width: 100%;"/>
                                    </t>                                                       
                                </div>
                            </div>
                        </div>
                    </div>

            <!-- chatter -->
            <div id="leave_communication" class="mt-4">
                <h4>
                    <strong>Message and communication history</strong>
                </h4>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="hr_attendance"/>
                </t>
            </div>

        </t>
    </template>

    <template id="my_attendance_create_new" name="Create New Attendance">
        <t t-call="portal.portal_layout">
            <div class="o_summary">
                        <div class="p_o_hr_attendance_kiosk_mode_container p_o_home_menu_background">
                            <span class="p_o_hr_attendance_kiosk_backdrop"/>
                            <div class="p_o_hr_attendance_kiosk_mode">
                                <t t-if="employee">
                                    <input t-if="employee" type="hidden" id="employee_input" 
                                        t-att-data-employee_id="employee.id"
                                        t-att-data-company_id="employee.company_id.id"
                                        t-att-data-user_id="employee.user_id.id"
                                        t-att-data-hr_attendance_geolocation_p="employee.company_id.hr_attendance_geolocation_p"
                                        t-att-data-hr_attendance_geofence_p="employee.company_id.hr_attendance_geofence_p"
                                        t-att-data-hr_attendance_face_recognition_p="employee.company_id.hr_attendance_face_recognition_p"
                                        t-att-data-hr_attendance_ip_p="employee.company_id.hr_attendance_ip_p"
                                        t-att-data-hr_attendance_reason_p="employee.company_id.hr_attendance_reason_p"
                                        />

                                    <div class="p_o_hr_attendance_user_badge p_o_home_menu_background">
                                        <img class="img rounded-circle" t-attf-src="/web/image?model=hr.employee.public&amp;field=image_128&amp;id=#{employee.id}"/>
                                    </div>
                                    <h1 class="mt8 mb8"><span t-field="employee.name"/></h1>
                                    <h3 class="mt8 mb8">
                                        <span class="kiosk_message"></span>
                                    </h3>
                                    <h4 class="mt0 mb0 text-muted hours_today">
                                        Today's work hours: <span></span>
                                    </h4>

                                    <div class="row mt8 mb8 p_o_attendance_reason" style="display: none;">
                                        <div class="col-8" style="margin-left: auto; margin-right: auto;">            
                                            <input type="text" name="reasons" id="p_o_attendance_reasons" list="reasons_list" class="o_input mt8 p_o_attendance_reasons" 
                                                placeholder="Select / Enter your Reason here." autocomplete="off"/>
                                            <datalist id="reasons_list">                        
                                                <t t-foreach="reasons" t-as="reasons">
                                                    <t t-foreach="reasons" t-as="reason" >    
                                                        <t t-if="employee.attendance_state == 'checked_out'">
                                                            <t t-if="reason.attendance_state == 'checked_in' or reason.attendance_state == False">
                                                                <option t-att-value="reason.name"/>                     
                                                            </t>
                                                        </t>
                                                        <t t-if="employee.attendance_state == 'checked_in'">
                                                            <t t-if="reason.attendance_state == 'checked_out' or reason.attendance_state == False">
                                                                <option t-att-value="reason.name"/>                     
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </datalist>
                                        </div>
                                    </div>
                                    
                                    <a class="fa fa-4x p_o_hr_attendance_sign_in_out_icon fa-sign-out btn-warning hr_attendance_sign_out_icon" style="display:none" aria-label="Sign out" title="Sign out"/>
                                    <a class="fa fa-4x p_o_hr_attendance_sign_in_out_icon fa-sign-in btn-secondary hr_attendance_sign_in_icon" style="display:none" aria-label="Sign in" title="Sign in"/>

                                    <h3 class="mt0 mb32 text-muted">
                                        Click to 
                                        <b class="hr_attendance_sign_out_text" style="display:none">check out</b>
                                        <b class="hr_attendance_sign_in_text" style="display:none">check in</b>
                                    </h3>

                                    <div class="p_o_glocation_kisok_container mb8" id="glocation_kisok" style="display: none;">
                                        <i class="fa fa-1x fa-angle-double-down p_o_glocation_kisok_toggle" id="p_o_glocation_kisok_toggle">
                                            Geo Location
                                        </i>
                                        <div class="p_o_glocation_kisok_view" style="display: none;">
                                            <span></span>
                                        </div>
                                    </div>

                                    <div class="p_o_gmap_kisok_container mb8" id="gmap_kisok" style="display: none;">
                                        <i class="fa fa-1x fa-angle-double-down p_o_gmap_kisok_toggle" id="p_o_gmap_kisok_toggle">
                                            Google Map Location
                                        </i>                                        
                                        <div class="p_o_gmap_kisok_view" style="display: none;"></div>
                                    </div>

                                    <div class="p_o_gip_kisok_container mb8" id="gip_kisok" style="display: none;">
                                        <i class="fa fa-1x fa-angle-double-down p_o_gip_kisok_toggle" id="p_o_gip_kisok_toggle">
                                            IP Address (Public)
                                        </i>
                                        <div class="p_o_gip_kisok_view" style="display: none;">
                                            <span></span>
                                        </div>
                                    </div>
                                </t>
                                <div t-else="" class="alert alert-danger mt8 ml8 mr8 mb8" role="alert">
                                    <b>Error: could not find corresponding employee.</b><br/>Please return to the main menu.
                                </div>
                            </div>
                        </div>
                    </div>
        </t>
    </template>

</odoo>