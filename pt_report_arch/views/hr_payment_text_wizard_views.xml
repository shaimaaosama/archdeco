<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payment_text_wizard_form" model="ir.ui.view">
        <field name="name">hr.payment.text.wizard.form</field>
        <field name="model">hr.payment.text.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payment Text File">
                <sheet>
                    <group>
                        <field name="payment_scope" widget="radio"/>
                        <field name="employee_ids"
                               widget="many2many_tags"
                               invisible="payment_scope != 'employee'"/>
                        <field name="enroll_employee_id"
                           invisible="payment_scope != 'enroll_employee'"/>
                        <field name="payment_company_id"/>
                        <field name="payment_date"/>
                        <label for="period_from" string="Period"/>
                        <div>
                            <field name="period_from" class="oe_inline" /> - <field name="period_to" class="oe_inline"/>
                        </div>
                        <field name="available_employee_ids" invisible="1"/>
                        <field name="currency_id"/>
                        <field name="payment_method"/>
                    </group>

                    <group string="Download File" invisible="not file_data">
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name" widget="binary"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate_text_file"
                            type="object"
                            string="Generate Text File"
                            class="btn-primary"/>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payment_text_wizard" model="ir.actions.act_window">
        <field name="name">Payment Text File</field>
        <field name="res_model">hr.payment.text.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- This adds it under Employees dropdown -->
    <menuitem id="menu_hr_payment_text_wizard"
              name="Payment Text File"
              parent="hr.hr_menu_hr_reports"
              action="action_hr_payment_text_wizard"
              sequence="50"/>

    <menuitem action="action_hr_payment_text_wizard"
              id="menu_hr_payment_text_wizard1"
              name="Payment Text File Report"
              parent="hr_payroll.menu_hr_payroll_report"
              sequence="20"/>


</odoo>