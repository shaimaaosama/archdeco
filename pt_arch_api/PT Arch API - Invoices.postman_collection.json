    {
      "name": "Get invoices - date filter (Saudi Riyadh DD/MM/YYYY)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://arch18.ptech.host/api/v2/pt_arch_api/invoices?date_from=01/02/2026&date_to=28/02/2026",
          "protocol": "https",
          "host": [
            "arch18",
            "ptech",
            "host"
          ],
          "path": [
            "api",
            "v2",
            "pt_arch_api",
            "invoices"
          ],
          "query": [
            {
              "key": "date_from",
              "value": "01/02/2026"
            },
            {
              "key": "date_to",
              "value": "28/02/2026"
            }
          ]
        },
        "description": "Filter invoices between 01/02/2026 and 28/02/2026 (DD/MM/YYYY interpreted as Asia/Riyadh)."
      },
      "response": []
    },
