<odoo>
    <record id="gs_partner_class_view_tree" model="ir.ui.view">
        <field name="name">gs.partner.class.view.tree</field>
        <field name="model">gs.partner.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="gs_partner_class_view_form" model="ir.ui.view">
        <field name="name">gs.partner.class.view.form</field>
        <field name="model">gs.partner.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                            <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_partner_class_action" model="ir.actions.act_window">
        <field name="name">Partner Class</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.partner.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_gs_partner_class" name="Partner Class"  parent="account.menu_finance_receivables" action="gs_partner_class_action" sequence="112"/>

</odoo>