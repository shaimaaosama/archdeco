<odoo>
    <record id="gs_partner_type_view_tree" model="ir.ui.view">
        <field name="name">gs.partner.type.view.tree</field>
        <field name="model">gs.partner.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="gs_partner_type_view_form" model="ir.ui.view">
        <field name="name">gs.partner.type.view.form</field>
        <field name="model">gs.partner.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                            <field name="name"/>
                            <field name="user_id" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_partner_type_action" model="ir.actions.act_window">
        <field name="name">Partner Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.partner.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_gs_partner_type" name="Partner Type"  parent="account.menu_finance_receivables" action="gs_partner_type_action" sequence="111"/>

</odoo>