<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_sale_order_header">
        <t t-set="company" t-value="user.company_id"/>
        <div class="o_force_rtl header">
            <div class="row" style="font-family: 'Trebuchet MS', sans-serif;">
                <div class="col-5 mb4">
                    <p>
                        <span>Quotation Reference:
                        </span>
                        <span t-field="doc.name"/>
                    </p>

                </div>
                <div class="col-2 mb4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:110px;"
                         alt="Logo"/>
                </div>
                <div class="col-5 mb4 text-right">
                    <div t-field="company.partner_id"
                         t-options='{"widget": "contact", "fields": ["name"], "no_marker": true}'
                    />
                    <div>
                    </div>
                    <div>
                        Date:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                    </div>
                </div>
            </div>
            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
        </div>
        <div class="footer" style="width:100%;font-family: Arial, Helvetica, sans-serif;direction: rtl;">
            <div class="mt-2 text-left" style="border-top:3px solid #CDDEFF;">
                <p style="margin-top:10px;">
                    <strong style="color:red;" t-field="company.name">
                    </strong>
                    <br/>
                    <span style="color:#98BAE7;"><span t-field="company.website"/>/
                        <span t-field="company.email"/>
                    </span>
                </p>
                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page:
                    <li class="list-inline-item">
                        <strong>
                            <span class="page"/>
                            /
                            <span class="topage"/>
                        </strong>
                    </li>
                </div>
            </div>
        </div>
    </template>
</odoo>