<odoo>
    <template id="report_sale_order_document1">
        <t t-call="web.html_container">
            <t t-set="company" t-value="user.company_id"/>
            <t t-set="total_before_amount1" t-value="0"/>

            <t t-set="count" t-value="0"/>
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc.with_context(lang='en_US')"/>
                <div class="header">
                    <h6 style="margin-top:10px;">
                        <center>
                            <strong>COMMERCIAL OFFER</strong>
                        </center>
                    </h6>
                    <div class="row">
                        <div class="col-3" style="margin-top:10px;padding-top:10px;color:#000;">
                            <p style="padding-top:10px;">
                                <span>Quotation Ref:
                                </span>
                                <br/>
                                <span>Date</span>
                            </p>
                        </div>
                        <div class="col-9" style="margin-top:25px;background-color:white;width:70%;">
                            <span t-field="doc.name"/>
                            <br/>
                            <strong t-field="doc.date_order"/>
                        </div>
                    </div>
                </div>
                <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">
<!--
                    <t t-call="gs_sale_quotation_report_custom.custom_sale_order_header"/>
-->
                    <style>
                        .table-striped tbody tr:nth-of-type(odd){
                        background-color: #CDDEFF;
                        }
                        .table-bordered {
                        border: 2px solid #eef2f3 !important;
                        }
                        @font-face {
                        font-family: 'Cairo-Regular';
                        src: local('Cairo-Regular'), local('Cairo-Regular'),
                        url(/gs_invoice_pdf_report/static/src/fonts/cairo/Cairo-Regular.ttf) format('opentype');
                        }

                        .font_cairo{
                        font-family: Cairo-Regular;
                        }

                        .gs_table {
                        border-collapse: collapse;
                        border: 0px solid #ddd;
                        float:right !important;
                        width:100%;
                        margin:auto;
                        }
                        .gs_table td {
                        height: 10px;
                        border-bottom: 1px solid #ddd;
                        vertical-align: middle;
                        font-size:16px;
                        padding:5;
                        }
                        gs_customer_info {
                        table-layout: fixed
                        }
                        .gs_customer_info td {
                        height: 10px;
                        vertical-align: middle;
                        padding:5;
                        }
                        .gs_customer_infor {
                        border-collapse: collapse;
                        }
                        .gs_customer_infor td {
                        vertical-align: middle;
                        }
                        .gs_customer_infor_td_vals{
                        float:left !important;text-align:left !important
                        }
                        gs_customer_info2{
                        border-collapse: collapse;
                        }
                        gs_customer_info2 tr td strong{font-color:#283779;}
                    </style>
                    <div class="page font_cairo">
                        <br/>

                        <div class="row">
                            <div class="col-3" style="margin-top:10px;padding-top:10px;color:#000;">
                                <p style="padding-top:10px;">
                                    <span>Customer</span>
                                    <br/>
                                    <span>Attn:</span>
                                    <br/>
                                    <span>Project:</span>
                                    <br/>
                                    <span>Subject:</span>
                                </p>
                            </div>
                            <div class="col-9" style="margin-top:25px;background-color:white;width:70%;">
                                <span t-field="doc.partner_id.name"/>
                                <br/>
                                <span t-field="doc.partner_id.contact_name"/>
                                <br/>
                                <span t-field="doc.project"/>
                                <br/>
                                <span t-field="doc.client_order_ref"/>
                                <br/>
                            </div>
                        </div>
                        <div style="margin-top:20px;">
                            <h5>Dear Sirs,</h5>
                            <p style="margin-top:10px;">
                                Thank you for giving us the opportunity to participate in the above mentioned project
                                and please find our
                                <br/>
                                offer along with below listed attachments:
                            </p>
                            <br/>
                            <div style="background-color:white;width:80%;margin:auto">
                                    <table>
                                        <t t-foreach="doc.product_detials" t-as="product">
                                            <tr style="color:#000000;font-weight:bold;">
                                                <td colspan="8">
                                                    <span t-field="product.prodcut_id"/>
                                                </td>
                                                <td style="color:white;">.....</td>
                                                <td style="color:white;">.....</td>
                                                <td style="color:white;">.....</td>
                                                <td style="color:white;">.....</td>
                                                <td colspan="">
                                                    <span t-field="product.brand"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                            </div>
                            <br/>

                            <div>
                                <u>
                                    <strong>Commercial Terms:
                                    </strong>
                                </u>
                                <div class="row">
                                    <div class="col-4">
                                        <b>Price Basis:</b>
                                        <b style="margin-left:7px;" t-field="doc.price_basis"/>
                                        <br/>
                                        <b>Offer Validity:</b>
                                        <span style="margin-left:7px;" t-field="doc.offer_validity"/>
                                        <br/>
                                        <b>Work Period:</b>
                                        <span style="margin-left:7px;" t-field="doc.work_period"/>

                                        <br/>
                                    </div>
                                    <div class="col-8" style="background-color:white">
                                        <table>
                                            <tr >
                                                <td style="font-weight:bold;">Project Location</td>
                                                <td>
                                                    <span style="margin-left:20px;" t-field="doc.project_location"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <br/>
                                <u>
                                    <b t-if="doc.payment_terms">Payment Terms:</b>
                                </u>
                                <div style="background-color:white;">
                                    <strong t-field="doc.payment_terms"/>
                                </div>
                                <br/>
                                <u t-if="doc.bank_detials">
                                    <b>Bank Details:
                                    </b>
                                </u>
                                <div class="row">
                                    <div class="col-6">
                                        <p>
                                            <strong t-field="doc.bank_detials"/>
                                        </p>
                                    </div>
                                </div>
                                <u>
                                    <b>Warranty:
                                    </b>
                                </u>
                                <div class="row">
                                    <div class="col-8">
                                        <b t-if="doc.matrial">.Material:</b>
                                        <b style="margin-left:10px;" t-field="doc.matrial"/>
                                        <br/>
                                        <b t-if="doc.install">.Install:</b>
                                        <b style="margin-left:10px;" t-field="doc.install"/>
                                    </div>
                                </div>
                                <p style="color:red">
                                    <b>*Terms and Conditions to be applied</b>
                                </p>

                            </div>
                        </div>
                        <p style="page-break-before:always!important;"></p>
                        <div style="padding:20px">
                            <u>General Conditions:
                            </u>
                            <p style="font-size:14px;">• This offer is for Supply or Supply and Installation. All screws, adhesive and/or any
                                components needed to install
                            </p>
                            <p style="font-size:14px;">the system will be provided by
                                <strong>ARCH
                                    <strong style="color:#CA8211">DECO</strong>
                                </strong>
                                unless otherwise stated
                                <br/>• The site must be clean, level, and free from any dirt, debris, oils, and/or any
                                materials that may obstruct the
                                installation
                            </p>
                            <p style="font-size:14px;">• A site delivery note should be signed before starting the work. After which, any damage
                                caused to our
                            </p>
                            <p style="font-size:14px;">undelivered work by any work or activity handled by the client or other subcontractors
                                will be charged
                                <br/>
                                • In case, we are carrying out work round the clock or extended hours to finish it fast,
                                all the facilities must be provided by the client on site
                            </p>
                            <p style="font-size:14px;">• The client should provide free access, safe working conditions and environment
                                <br/>• The client should provide water, power, light and other facilities to carry out
                                the work easily and fast
                                <br/>• The client should provide a covered store and a site office space with provision
                                for internet and electricity free of charge.
                                <strong>ARCH
                                    <strong style="color:#CA8211;">DECO</strong>
                                </strong>
                                is responsible of furnishing

                            </p>
                            <p style="font-size:14px;">• The client should provide necessary equipments, cranes, scaffolds and hoists needed to
                                offload the material and
                                <br/>transpot them to the concerned area free of charge

                            </p>
                            <p style="font-size:14px;">• The customer has to provide a container inside the project to throw the waste materials
                                <br/>• Spare quantity is not included in our offer. If required, it will be invoiced
                                separately
                                <br/>• Mock-up will be invoiced separately
                                <br/>• Any change to quantities and/or specifications that may affect the cost will
                                therefore affect the prices shown in
                                the price table<br/>• Once the work is completed, it will be handed over to the client
                                or his representative and after which any
                                <br/>damage caused by any means will not be our responsibility


                            </p>
                            <u>
                                <strong>Special Conditions:
                                </strong>
                            </u>
                            <p style="font-size:14px;">
                                <strong t-field="doc.special_conditions">
                                </strong>
                            </p>
                            <table style="width:100%;border:2px solid #000000">
                                <thead style="background-color:#DAA520;color:#0000;padding:15px;">
                                    <tr>
                                        <th style="color:#fff;width:25%;border:1px solid #000000;">Create BY</th>
                                        <th style="color:#fff;width:25%;border:1px solid #000000;">Sales Person</th>
                                        <th style="color:#fff;width:25%;border:1px solid #000000;">Approved Person</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="color:#000000;width:25%;border:1px solid #000000;">
                                            <span style="font-size:12px;" t-field="doc.create_uid.name"/>
                                        </td>
                                        <td style="color:#000000;width:25%;border:1px solid #000000;">
                                            <span style="font-size:12px;" t-field="doc.user_id.name"/>
                                        </td>
                                        <td style="color:#000000;width:25%;border:1px solid #000000;">
                                            <span style="font-size:12px;" t-field="doc.approval_rs_user_id.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p style="page-break-before:always!important;"></p>

                        <!--  create the invoice table -->
                        <t t-set="seq" t-value="1"/>
                        <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>
                        <table class="text-center gs_table mt-2"
                               style="width:100%;border:0;direction: ltr;">
                            <thead style="background-color:#DAA520;color:#fff;padding:15px;">
                                <tr>
                                    <th style="width:5%; font-size:12px">
                                        <span>SN.</span>
                                    </th>
                                    <th name="th_description" style="width:43%; font-size:12px">
                                        <span>Description</span>
                                        <!--                                        <br/>-->
                                        <!--                                        <span>الوصف</span>-->
                                    </th>
                                    <th name="th_brand" style="font-size:12px">
                                        <span>Unit</span>
                                        <!--                                                                            <br/>-->
                                        <!--                                                                            <span>المصنع/الكود</span>-->
                                    </th>
                                    <th style="width:8%;" name="th_quantity">
                                        <span style="font-size:12px;">Qty</span>
                                        <!--                                        <br/>-->
                                        <!--                                        <span style="font-size:12px;">الكمية</span>-->
                                    </th>
                                    <th name="th_priceunit">
                                        <strong style="font-size:12px;">Unit Price(SAR)</strong>
                                        <!--                                        <br/>-->
                                        <!--                                        <strong style="font-size:12px;">سعر الوحدة</strong>-->
                                    </th>
                                    <t t-if="display_discount">
                                        <th style="font-size:12px" name="th_price_unit2">
                                            <span style="">Disc</span>
                                            <th style="font-size:12px" class="text-center" name="th_subtotal">
                                                <span groups="account.group_show_line_subtotals_tax_excluded">Total
                                                    Price(SAR)
                                                </span>
                                            </th>
                                        </th>
                                    </t>

                                    <t t-else="">
                                        <th style="font-size:12px" class="text-center" name="th_subtotal">
                                            <span groups="account.group_show_line_subtotals_tax_excluded">Total
                                                Price(SAR)
                                            </span>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                       groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                       groups="account.group_show_line_subtotals_tax_included"/>
                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type">
                                            <td name="seq" style="width:4%;">
                                                <span t-esc="seq"/>
                                                <t t-set="seq" t-value="seq+1"/>
                                            </td>
                                            <td name="td_name">
                                                <span style='float:left;font-size:12px;text-align:left'
                                                      t-options="{'widget': 'text'}"
                                                      t-field="line.name"/>
                                            </td>
                                            <td name="td_name">
                                                <span t-field="line.product_uom"/>
                                            </td>
                                            <td style="font-size:12px;width:8%;" name="td_quantity">
                                                <span t-field="line.product_uom_qty"/>
                                                <!--                                                <br/>-->
                                                <!--                                                <span t-field="line.product_uom"/>-->
                                            </td>
                                            <td name="td_priceunit" style="width:10%;">
                                                <span class="text-nowrap" t-field="line.price_unit"/>
                                            </td>
                                            <t t-if="display_discount">
                                                <td style="width:8%;">
                                                    <span class="text-nowrap" t-field="line.discount"/>%
                                                </td>
                                                <td class="o_price_total">
                                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                                          groups="account.group_show_line_subtotals_tax_excluded"/>
                                                    <span class="text-nowrap" t-field="line.price_total"
                                                          groups="account.group_show_line_subtotals_tax_included"/>

                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td class="o_price_total">
                                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                                          groups="account.group_show_line_subtotals_tax_excluded"/>
                                                    <span class="text-nowrap" t-field="line.price_total"
                                                          groups="account.group_show_line_subtotals_tax_included"/>
                                                </td>
                                            </t>

                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td name="td_section_line" colspan="99">
                                                <span style="float:left;direction: ltr;text-align:left" t-field="line.name"
                                                      t-options="{'widget': 'text'}"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td name="td_note_line" colspan="99">
                                                <span style="float:left;direction: ltr;text-align:left" t-options="{'widget': 'text'}"
                                                      t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                        <!--                                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">-->
                                        <tr class="is-subtotal">
                                            <td colspan="99">
                                                <strong style="float:left" class="mr16">Subtotal</strong>
                                                <span style="float:left"
                                                      t-esc="current_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <!--                                        </t>-->

                                    </t>
                                    <t t-set="total_before_amount1"
                                       t-value="total_before_amount1+(line.price_unit*line.product_uom_qty)"/>
                                </t>
                                <t t-set="disc1" t-value="total_before_amount1-o.amount_untaxed"/>
                                <tr t-if="display_discount" style="">
                                    <td colspan="5" class="text-left">
                                        <strong>Total Be.Disc
                                        </strong>
                                    </td>
                                    <td class="text-left">
                                        <span class="gs_customer_infor_td_vals" t-esc="total_before_amount1"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>

                                <tr t-if="display_discount" class="border-black o_subtotal" style="">
                                    <td style="" colspan="5" class="text-left">
                                        <strong>Disc
                                        </strong>
                                    </td>
                                    <td class="text-left">
                                        <span class="gs_customer_infor_td_vals" t-esc="disc1"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-if="display_discount">
                                    <tr>
                                        <td colspan="5" class="text-left" style="color:#228B22">
                                            <strong>Total Price Excluding VAT</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="" t-field="o.amount_untaxed"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-left" colspan="5">
                                            <strong>VAT (15%)</strong>
                                        </td>
                                        <td class="text-center o_price_total">
                                            <span t-field="o.amount_tax"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-left" colspan="5" style="color:#B22222">
                                            <strong>Total Price Including VAT</strong>
                                        </td>
                                        <td class="text-center">
                                            <strong class="text-nowrap" t-field="o.amount_total"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else=''>
                                    <tr>
                                        <td colspan="5" class="text-left" style="color:#228B22">
                                            <strong>Total Price Excluding VAT</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="" t-field="o.amount_untaxed"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-left" colspan="5">
                                            <strong>VAT (15%)</strong>
                                        </td>
                                        <td class="text-center o_price_total">
                                            <span t-field="o.amount_tax"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-left" colspan="5" style="color:#B22222">
                                            <strong>Total Price Including VAT</strong>
                                        </td>
                                        <td class="text-center">
                                            <strong class="text-nowrap" t-field="o.amount_total"/>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
                        <br/>
                        <div>
                            <h5>Note that:</h5>
                            <p>
                                <b>
                                    The above offered prices are VALID only if all the items
                                    and quantity
                                    offered are ordered Together.

                                </b>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!--    <template id="gs_report_sale_order_document" inherit_id="sale.report_saleorder_document">-->
    <!--        <xpath expr="//t" position="replace">-->
    <!--            <t t-call="gs_sale_quotation_report_custom.report_sale_order_document1"/>-->
    <!--        </xpath>-->
    <!--    </template>-->


    <!-- QWeb Reports -->
    <record id="sale_order_report" model="ir.actions.report">
        <field name="name">Print Quotation/Order امرمكونات-عرض مكونات</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gs_sale_quotation_report_custom.report_sale_order_document1</field>
        <field name="report_file">gs_sale_quotation_report_custom.report_sale_order_document1</field>
        <field name="paperformat_id" ref="gs_sale_quotation_report_custom.paperformat_sale_order_report"/>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="print_report_name">'Sale Quotation/Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
