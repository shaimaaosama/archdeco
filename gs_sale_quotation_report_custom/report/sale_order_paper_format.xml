<odoo>
    <!--    create paper format for invoice-->
    <record id="paperformat_sale_order_report" model="report.paperformat">
        <field name="name">A4 Sale Order report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">70</field>
        <field name="margin_bottom">34</field>
        <field name="margin_left">2</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>
</odoo>