<odoo>
    <data>
        <record id="gs_sales_salesperson_readonly_inherit_form" model="ir.ui.view">
            <field name="name">sale.order.form.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="is_salesperson_readonly" invisible="1" readonly="0"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="readonly">is_salesperson_readonly == True</attribute>
                </xpath>
            </field>
        </record>

        <record id="gs_account_move_salesperson_readonly_inherit_form" model="ir.ui.view">
            <field name="name">account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <!--            <field name="groups_id" eval="[(6, 0, [ref('gs_sales_salesperson_readonly.group_salesperson_readonly') ])]"/>-->
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                    <attribute name="readonly">is_salesperson_readonly</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_user_id']" position="before">
                    <field name="is_salesperson_readonly" invisible="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>