<odoo>

    <record id="gs_reason_view_tree" model="ir.ui.view">
        <field name="name">gs.reason.view.tree</field>
        <field name="model">gs.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="gs_reason_view_form" model="ir.ui.view">
        <field name="name">gs.reason.view.form</field>
        <field name="model">gs.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                         <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_reason_action" model="ir.actions.act_window">
        <field name="name">Reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_gs_reason" name="Reason"  parent="sale.menu_sale_config" action="gs_reason_action" sequence="100" groups="base.group_system"/>

</odoo>