<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gs_view_sale_advance_payment_inv_form_inherit" model="ir.ui.view">
		    <field name="name">view.sale.advance.payment.inv.form</field>
		    <field name="model">sale.advance.payment.inv</field>
            <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='advance_payment_method']"  position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='has_down_payments']"  position="after">
                    <b>Are you sure to Create Draft Invoice?</b>
                </xpath>
            </field>
        </record>

        <record id="gs_view_account_move_form_inherit" model="ir.ui.view">
		    <field name="name">view.account.move.form</field>
		    <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='other_info']/group//group[@name='sale_info_group']"  position="inside">
                    <field name="move_ids" widget="many2many_tags" readonly="1"/>
                </xpath>
            </field>
        </record>
		<record id="gs_view_sale_order_form_inherit" model="ir.ui.view">
		    <field name="name">view.sale.order.form</field>
		    <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//header"  position="inside">
                    <button name="action_create_one_credit_note" string="Create One Credit Note" invisible="gs_is_create == True or state != 'sale'" type="object" class="oe_highlight" />
                </xpath>
                <div name="button_box" position="inside">
                    <button name="action_view_credit_note" type="object" class="oe_stat_button" icon="fa-file" invisible="credit_note_count == 0">
                        <field name="credit_note_count" widget="statinfo" string="Credit Note" help="Credit Note" />
                    </button>
                </div>-->
                <xpath expr="//field[@name='order_line']//list" position="inside">
                    <field name="partner_id" column_invisible="1"/>
                    <field name="reason_id" optional="hidden"/>
                    <field name="mm_move_id" optional="hidden" domain="[('partner_id','=', partner_id),('journal_id.type', '=', 'sale')]"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="gs_is_create" invisible="1"/>
                    <field name="mm_move_id" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
