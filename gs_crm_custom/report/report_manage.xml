<odoo>
  <data>
      <record id="price_study_request_report_paperformat1" model="report.paperformat">
        <field name="name">A4 Contract report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="price_study_request_report_action" model="ir.actions.report">
        <field name="name">Price Study Request</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gs_crm_custom.price_study_request_order_report</field>
        <field name="report_file">gs_crm_custom.price_study_request_order_report</field>
        <field name="paperformat_id" ref="gs_crm_custom.price_study_request_report_paperformat1"/>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="print_report_name">'Contract - %s' % (object.name) </field>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_type">report</field>
    </record>
  </data>
</odoo>