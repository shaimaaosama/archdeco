                        @font-face {
                        font-family: 'AL-Mohanad Bold';
                        src: local('AL-Mohanad Bold'), local('AL-Mohanad Bold'),
                        url(/gs_crm_custom/static/src/fonts/AL-Mohanad Bold.ttf) format('opentype');
                        }

                        .font_cairo{
                        font-family: AL-Mohanad Bold;
                        }

                        .gs_table {
                        border-collapse: collapse;
                        border: 0px solid #000000;
                        float:right !important;
                        width:100%;
                        margin:auto;
                        }
                        .gs_table td {
                        height: 25px;
                        border-bottom: 1px solid #000000;
                        vertical-align: middle;
                        font-size:16px;
                        padding:5;
                        }
                        .gs_table th {
                        height: 25px;
                        border-bottom: 1px solid #000000;
                        vertical-align: middle;
                        font-size:16px;
                        padding:5;
                        }
                        gs_customer_info {
                        table-layout: fixed
                        }
                        .gs_customer_info td {
                        height: 10px;
                        vertical-align: middle;
                        padding:5;
                        }
                        .gs_customer_infor {
                        border-collapse: collapse;
                        }
                        .gs_customer_infor td {
                        vertical-align: middle;
                        }
                        .gs_customer_infor_td_vals{
                        float:left !important;text-align:left !important
                        }
                        gs_customer_info2{
                        border-collapse: collapse;
