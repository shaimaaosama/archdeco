<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_type_class_res_partner_user" model="ir.rule">
        <field name="name">Payment Term Restriction User</field>
        <field ref="account.model_account_payment_term" name="model_id"/>
        <field name="domain_force">[('id', 'in', user.payment_term_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="partner_type_class_res_partner_admin" model="ir.rule">
        <field name="name">Payment Term Restriction Admin</field>
        <field ref="account.model_account_payment_term" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>