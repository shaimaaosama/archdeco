<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_boq_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.boq.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="can_see_boq" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="BOQ" name="boq" invisible="can_see_boq == False">

                    <field name="boq_component_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="allowed_component_product_ids" column_invisible="1"/>
                            <field name="component_id" width="180px"/>
                            <field name="quantity" readonly="1" width="90px"/>
                            <field name="component_unit_cost" readonly="1" width="105px"/>
                            <field name="materials_total_cost" sum="Total" readonly="1" width="120px"/>
                            <field name="overhead_percentage" width="100px"/>
                            <field name="overhead_amount" readonly="1" sum="Total" width="110px"/>
                            <field name="total_cost" readonly="1" sum="Total Cost" width="120px"/>
                        </list>

                        <form string="BOQ Component">
                            <sheet>

                                <field name="currency_id" invisible="1"/>

                                <group>
                                    <group>
                                        <field name="allowed_component_product_ids" invisible="1"/>
                                        <field name="component_id"/>
                                        <field name="quantity" readonly="1"/>
                                    </group>

                                    <group>
                                        <field name="component_unit_cost" readonly="1"/>
                                        <field name="materials_total_cost" readonly="1"/>
                                        <field name="overhead_percentage"/>
                                        <field name="overhead_amount" readonly="1"/>
                                        <field name="total_cost" readonly="1"/>
                                    </group>
                                </group>

                                <notebook>
                                    <page string="Materials" name="boq_materials">

                                        <field name="material_line_ids" nolabel="1">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="currency_id" column_invisible="1"/>
                                                <field name="material_id" width="150px"/>
                                                <field name="description" width="150px"/>
                                                <field name="quantity" sum="Total Quantity" width="110px"/>
                                                <field name="unit_cost" width="130px"/>
                                                <field name="total_cost" readonly="1" sum="Materials Total Cost" width="140px"/>
                                                <field name="notes"/>
                                            </list>

                                            <form string="BOQ Material Line">
                                                <sheet>

                                                    <field name="currency_id" invisible="1"/>

                                                    <group>
                                                        <group>
                                                            <field name="material_id"/>
                                                            <field name="quantity"/>
                                                        </group>

                                                        <group>
                                                            <field name="unit_cost"/>
                                                            <field name="total_cost" readonly="1"/>
                                                        </group>
                                                    </group>

                                                </sheet>
                                            </form>
                                        </field>

                                    </page>
                                </notebook>

                            </sheet>
                        </form>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

    <record id="sale_order_form_secondary_unit_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.secondary.unit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sh_secondary_unit.sh_sale_order_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='sh_sec_qty']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='sh_sec_uom']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="unit_cost" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_add_expected_expense" model="ir.ui.view">
        <field name="name">sale.order.form.add.expected.expense</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="gs_sale_quotation_report_custom.sale_order"/>
        <field name="arch" type="xml">
            <xpath expr="(//page[@name='customer_signature']/following-sibling::page[1]/group/group)[last()]" position="after">
                <group>
                    <field name="total_expected_expense" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>


    <record id="gs_sales_permission_view_form_inherit_boq" model="ir.ui.view">
        <field name="name">gs.sales.permission.view.form.inherit.boq</field>
        <field name="model">gs.sales.permission</field>
        <field name="inherit_id" ref="gs_sales_permission.gs_sales_permission_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='set_so_id']" position="after">
                <field name="can_see_boq_user_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="boq_required_branch_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

</odoo>