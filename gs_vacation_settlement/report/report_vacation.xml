<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_vacation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.layout">
                    <t t-set="o" t-value="doc.with_context(lang=lang)"/>
                    <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name"
                         t-att-data-oe-id="doc and doc.id">
                         <t t-call="gs_vacation_settlement.custom_vacation_order_header"/>
                        <style>
                            @font-face {
                                font-family: 'Cairo-Regular';
                                src: local('Cairo-Regular'), local('Cairo-Regular'),
                                url(/gs_invoice_pdf_report/static/src/fonts/cairo/Cairo-Regular.ttf) format('truetype');
                            }

                            .font_cairo {
                                font-family: Cairo-Regular;
                            }

                            .gs_table {
                                border-collapse: collapse;
                                border: 1px solid #000;
                                width: 100%;
                                margin: auto;
                            }

                            .gs_table th, .gs_table td {
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 12px;
                            }

                            .text-left {
                                text-align: left;
                                direction: ltr;
                            }

                            .text-right {
                                text-align: right;
                                direction: rtl;
                            }

                            .text-center {
                                text-align: center;
                            }

                            .page {
                                font-family: 'Cairo-Regular', sans-serif;
                                margin: 20px;
                            }

                            h2, h3 {
                                color: #3B124C;
                                text-align: center;
                                margin-bottom: 20px;
                            }
                        </style>

                        <div class="page font_cairo" style="margin-top:10px">
                            <br/><br/>
                            <table class="gs_table" style="direction: rtl;">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;font-size:25px;" colspan="4">Vacation Settlement/ تسوية الإجازة </th>
                                    </tr>
                                    <tr>
                                        <th style="text-align:center;font-size:18px;" colspan="4">معلومات الموظف  </th>
                                    </tr>
                                    <tr>
                                        <th>اسم الموظف:</th>
                                        <th><t t-esc="doc.employee_id.name"/></th>
                                        <th>القسم:</th>
                                        <th><t t-esc="doc.employee_id.department_id.name"/></th>
                                    </tr>
                                    <tr>
                                        <th>الوظيفة:</th>
                                        <th><t t-esc="doc.employee_id.job_id.name"/></th>
                                        <th>الراتب:</th>
                                        <th><t t-esc="doc.total_salary"/></th>
                                    </tr>
                                    <tr>
                                        <th>العقد الحالي:</th>
                                        <th><t t-esc="doc.current_contract_id.name"/></th>
                                        <th>تاريخ بداية العقد الحالي:</th>
                                        <th><t t-esc="doc.current_contract_id.date_start"/></th>
                                        
                                    </tr>
                                </thead>
                            </table>        
                            <table class="gs_table" style="direction: rtl;">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;font-size:18px;" colspan="4">تفاصيل الاجازة </th>
                                    </tr>
                                    <tr>
                                        <th>تاريخ بدء الاجازة </th>
                                        <th><t t-esc="doc.leave_start_date"/></th>
                                        <th>تاريخ نهاية الاجازة</th>
                                        <th><t t-esc="doc.leave_end_date"/></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2">تاريخ اخر يوم عمل </th>
                                        <th colspan="2"><t t-esc="doc.last_work_date"/></th>
                                    </tr>
                                    <tr>
                                        <th>عدد أيام الاجازة</th>
                                        <th><t t-esc="doc.num_of_vacation"/></th>
                                        <th>عدد أيام الإجازة المالية</th>
                                        <th><t t-esc="doc.financially_accrued_leave"/></th>
                                    </tr>
                                    <tr>
                                        <th>أجر اليوم </th>
                                        <th><t t-esc="doc.todays_pay"/></th>
                                        <th>القيمة</th>
                                        <th><t t-esc="doc.amount_due"/></th>
                                    </tr>
                                    <tr>
                                        <th>بدل تذكرة سنوية </th>
                                        <th><t t-esc="doc.tickets_val_company"/></th>
                                        <th>أخري</th>
                                        <th></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2">Total / إجمالي (بدل الاجازات + التذكرة)</th>
                                        <th colspan="2"><t t-esc="doc.tickets_val_company + doc.amount_due"/></th>
                                    </tr>
                                 </thead>   
                            </table>    
                            <table class="gs_table" style="direction: rtl;">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;font-size:18px;" colspan="3">العهد و الخصومات</th>
                                    </tr>
                                   
                                <tr>
                                        <th>Total Allowances / إجمالي البدلات</th>
                                        <th colspan="2"><t t-esc="doc.total_allowances"/></th>

                                    </tr>
                                <tr>
                                        <th>Total Deductions / (سلف-حسميات)إجمالي الخصومات</th>
                                        <th colspan="2"><t t-esc="doc.total_detuction"/></th>

                                        </tr>
                                    <tr>
                                        <th>Amount Due / المبلغ المستحق</th>
                                        <th colspan="2"><t t-esc="doc.amount_due"/></th>

                                        </tr>
                                        <tr>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 33%;">إجمالي المستحق للموظف</th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 33%;">
                                                <!-- <span t-esc="doc.total_amount_in_words('ar_AA', doc.total_total)"/> -->
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 33%;">
                                                <t t-esc="doc.total_total"/>
                                            </th>
                                        </tr>
                                </thead>
                            </table> 
                            <div>
                                <div style="margin-top:5px; text-align: center;direction: rtl;">
                                    <div style="display: inline-block; width: 30%;">
                                        <p>إعداد شؤون الموظفين</p>
                                    </div>
                                    <div style="display: inline-block; width: 30%;">
                                        <p>مراجعة الحسابات</p>
                                    </div>
                                    <div style="display: inline-block; width: 30%;">
                                        <p>اعتماد</p>
                                    </div>
                                </div>
                            </div>     
                            <div style="direction: rtl; text-align: right; margin-top:10px;">
                                <br/>

                               <hr />
                            
                                <div class="sign-section">
                                    <p>إقرار الموظف بالاستلام:</p>
                                    <p>أقر أنا الموظف / .....................................................</p>
                                    <p>بأنه تم استلامي لجميع المبالغ الموضحة بالجدول أعلاه.</p>
                                    <p>التوقيع: </p>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

