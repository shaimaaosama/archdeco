<odoo>
    <record id="gs_option_view_tree" model="ir.ui.view">
        <field name="name">gs.option.view.tree</field>
        <field name="model">gs.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="gs_option_view_form" model="ir.ui.view">
        <field name="name">gs.option.view.form</field>
        <field name="model">gs.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                            <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_option_action" model="ir.actions.act_window">
        <field name="name">Option</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.option</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_gs_option" name="Option"  parent="account.menu_finance_receivables" action="gs_option_action" sequence="115"/>

</odoo>