<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gs_payment_approval_line_form" model="ir.ui.view">
        <field name="name">gs.payment.approval.line</field>
        <field name="model">gs.payment.approval.line</field>
        <field name="arch" type="xml">
            <form string="Create Approval Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="approve_by"/>
                            <field name="level"/>
                            <field invisible="1" name="is_boolean"/>
                            <field invisible="1" name="payment_approval_config_id"/>
                        </group>
                        <group>
                            <field invisible="1" name="from_amount"/>
                            <field invisible="1" name="to_amount"/>
                        </group>
                    </group>
                    <field invisible="is_boolean == True" name="user_ids" nolabel="1"/>
                    <field invisible="is_boolean != True" name="group_ids" nolabel="1"/>
                </sheet>
            </form></field>
    </record>
</odoo>
