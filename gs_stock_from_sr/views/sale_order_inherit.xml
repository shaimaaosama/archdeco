<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gs_sr_sale_order_search_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='order_date']" position="before">
                    <separator/>
                    <filter context="{'group_by':'delivery_order'}" name="delivery_order" string="Delivery Order"/>
                </xpath></field>
        </record>
        <record id="gs_sr_sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_draft']" position="after">
                    <button class="oe_highlight" invisible="is_delivery == True or delivered == True" name="action_create_delivery" string="Create Delivery" type="object"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field invisible="1" name="is_delivery" readonly="0"/>
                    <field invisible="1" name="delivered" readonly="0"/>
                    <field invisible="1" name="confirm_user_id" readonly="0"/>
                </xpath></field>
        </record>
        <record id="gs_sr_sale_order_tree_inherit" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='activity_ids']" position="before">
                    <field name="delivery_order"/>
                </xpath></field>
        </record>
    </data>
</odoo>
