<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <data>
    <record id="view_account_payment_form_partner_domain" model="ir.ui.view">
      <field name="name">account.payment.form.partner_domain</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_form"/>
      <field name="arch" type="xml">

        <xpath expr="//field[@name='partner_id'][1]" position="attributes">
          <attribute name="domain">[('customer', '=', True)]</attribute>
          <attribute name="context">{'default_customer': True}</attribute>
        </xpath>
        <xpath expr="//field[@name='partner_id'][2]" position="attributes">
          <attribute name="domain">[('vendor', '=', True)]</attribute>
          <attribute name="context">{'default_vendor': True}</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>