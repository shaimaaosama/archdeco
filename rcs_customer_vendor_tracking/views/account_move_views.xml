<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_view_form_partner_filter" model="ir.ui.view">
        <field name="name">account.move.form.partner.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id"
                       domain="[('customer', '=', True)]"
                       context="{'default_customer': True}"
                       invisible="move_type not in ('out_invoice','out_refund','out_receipt')"/>

                <field name="partner_id"
                       domain="[('vendor', '=', True)]"
                       context="{'default_vendor': True}"
                       invisible="move_type not in ('in_invoice','in_refund','in_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>