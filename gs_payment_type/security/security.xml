<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="group_gs_payment">
        <field name="name">Payment</field>
        <field name="sequence">0</field>
    </record>

    <record id="group_gs_payment_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="group_gs_payment"/>
    </record>

    <record id="group_gs_payment_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="group_gs_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_gs_payment_user'))]"/>
    </record>

    <record id="payment_type_restriction_user" model="ir.rule">
        <field name="name">Payment Type User</field>
        <field ref="model_gs_account_payment_type" name="model_id"/>
        <field name="domain_force">[('id', 'in', user.payment_type_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('gs_payment_type.group_gs_payment_user'))]"/>
    </record>

    <record id="payment_type_restriction_admin" model="ir.rule">
        <field name="name">Payment Type Admin</field>
        <field ref="model_gs_account_payment_type" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('gs_payment_type.group_gs_payment_admin'))]"/>
    </record>
</odoo>