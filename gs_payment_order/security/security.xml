<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_special_approval" model="res.groups">
        <field name="name">Special Approval</field>
    </record>

    <record model="ir.module.category" id="group_gs_payment_type_po">
        <field name="name">PO Payment</field>
        <field name="sequence">0</field>
    </record>

    <record id="group_gs_payment_type_po_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="group_gs_payment_type_po"/>
    </record>

    <record id="group_gs_payment_type_po_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="group_gs_payment_type_po"/>
        <field name="implied_ids" eval="[(4, ref('group_gs_payment_type_po_user'))]"/>
    </record>

    <record id="payment_type_po_user_rule" model="ir.rule">
        <field name="name">PO Payment Type User</field>
        <field ref="model_gs_payment_type" name="model_id"/>
        <field name="groups" eval="[(4, ref('gs_payment_order.group_gs_payment_type_po_user'))]"/>
        <field name="domain_force">[('id', 'in', user.payment_type_po_ids.ids)]</field>
    </record>

    <record id="payment_type_po_manager_rule" model="ir.rule">
        <field name="name">PO Payment Type Manager</field>
        <field ref="model_gs_payment_type" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('gs_payment_order.group_gs_payment_type_po_admin'))]"/>
    </record>

    <record id="payment_order_po_user_rule" model="ir.rule">
        <field name="name">PO Payment Order User</field>
        <field ref="model_gs_payment_order" name="model_id"/>
        <field name="groups" eval="[(4, ref('gs_payment_order.group_gs_payment_type_po_user'))]"/>
        <field name="domain_force">[('payment_type_id', 'in', user.payment_type_po_ids.ids)]</field>
    </record>

    <record id="payment_order_po_manager_rule" model="ir.rule">
        <field name="name">PO Payment Order Manager</field>
        <field ref="model_gs_payment_order" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('gs_payment_order.group_gs_payment_type_po_admin'))]"/>
    </record>

</odoo>