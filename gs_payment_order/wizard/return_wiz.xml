<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gs_return_wizard_view_form" model="ir.ui.view">
        <field name="name">gs.return.wizard.form</field>
        <field name="model">gs.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="state" required="1"/>
                    <field name="return_comment" required="1"/>
                </group>
                <footer>
                    <button name="return_wizard" string='Create' type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="gs_return_wizard_action" model="ir.actions.act_window">
        <field name="name">Return</field>
        <field name="res_model">gs.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="gs_return_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
