<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_for_special_approval_payment_order" model="mail.template">
            <field name="name">Payment Order : Special Approval</field>
            <field name="model_id" ref="gs_payment_order.model_gs_payment_order"/>
            <field name="subject">Special Approval</field>
            <field name="email_from"></field>
            <field name="email_to"></field>

            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <h2>
                            <b>Special Approval:
                                <t t-out="object.name or ''"/>
                            </b>
                        </h2>
                        <br/>
                        <br/>
                        <p>
                            Dear Approver,
                            <br/>
                            <br/>
                            This is inform you that payment order is special approval.
                            <br/>
                            <b>Customer:</b>
                            <t t-out="object.partner_id.name or ''"/>
                            <br/>
                            <b>Total Amount:</b>
                            <t t-out="format_amount(object.amount, object.currency_id) or '' "/>
                            <br/>
                            <b>Approval Level:</b>
                            <t t-out="object.approval_level_id.name or ''"/>
                            <br/>
                            <b>Minimum Amount:</b>
                            <t t-out="format_amount(object.approval_level_id.min_amount, object.currency_id) or '' "/>
                            <br/>
                            <br/>
                            payment order Approval information as below
                        </p>
                        <br/>
                        <br/>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Level</th>
                                    <th scope="col">Approvers</th>
                                    <th scope="col">Approved Date</th>
                                    <th scope="col">Approved By</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <t t-foreach="object.approval_info_line" t-as="line">
                                <tbody>
                                    <tr>
                                        <th>
                                            <t t-out="line.level or ''"/>
                                        </th>
                                        <td>
                                            <t t-if="line.user_ids">
                                                <t t-foreach="line.user_ids" t-as="user">
                                                    <i><t t-out="user.name or ''"/>,
                                                    </i>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="line.group_ids" t-as="group">
                                                    <i><t t-out="group.name or ''"/>,
                                                    </i>
                                                </t>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-out="line.approval_date or ''"/>
                                        </td>
                                        <td>
                                            <t t-out="line.approved_by.name or ''"/>
                                        </td>
                                        <td>
                                            <t t-out="line.status or ''"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </t>
                        </table>
                        <br/>
                        <br/>
                        if you are authorize approver as per approval level.
                        <br/>
                        You can use the following link and approve the payment order
                        <br/>
                        <br/>

                        <div style="display: inline-block; margin: 15px; text-align: center">
                            <a href="/mail/view?model=gs.payment.order&amp;res_id=${object.id}" target="_blank"
                               style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px"
                            >Payment Order Ref: <t t-out="object.name or ''" />
                            </a>
                        </div>
                        <br/>
                        Thanks.
                    </p>
                </div>
            </field>
        </record>
