<odoo>
    <record id="gs_payment_type_view_tree" model="ir.ui.view">
        <field name="name">gs.payment.type.view.tree</field>
        <field name="model">gs.payment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="finalize_payment_user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="gs_payment_type_view_form" model="ir.ui.view">
        <field name="name">gs.payment.type.view.form</field>
        <field name="model">gs.payment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="finalize_payment_user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_payment_type_action" model="ir.actions.act_window">
        <field name="name">Payment Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.payment.type</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>