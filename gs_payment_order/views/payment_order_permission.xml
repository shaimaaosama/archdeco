<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gs_payment_order_permission_view_tree" model="ir.ui.view">
        <field name="name">gs.payment.order.permission.view.tree</field>
        <field name="model">gs.payment.order.permission</field>
        <field name="arch" type="xml">
            <list>
                <field name="permission_type"/>
            </list></field>
    </record>
    <record id="gs_payment_order_permission_view_form" model="ir.ui.view">
        <field name="name">gs.payment.order.permission.view.form</field>
        <field name="model">gs.payment.order.permission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <label for="permission_type"/>
                        <field name="permission_type"/>
                        <group invisible="permission_type != 'payment_order'">
                            <field invisible="permission_type != 'payment_order'" name="submit_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="approve_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="draft_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="cancel_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="special_approval_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="create_payment_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                        </group>
                        <group invisible="permission_type != 'payment_order'">
                            <field invisible="permission_type != 'payment_order'" name="reject_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="checked_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="finalize_payment_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="final_check_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="closed_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                            <field invisible="permission_type != 'payment_order'" name="return_t_id" required="permission_type == 'payment_order'" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form></field>
    </record>
    <record id="gs_payment_order_permission_action" model="ir.actions.act_window">
        <field name="name">Payment Order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gs.payment.order.permission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
