<odoo>
    <record id="account_payment_order_view_tree" model="ir.ui.view">
        <field name="name">account.payment.inherit.tree</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="payment_order_id" readonly="1"/>
                <field name="is_posted" readonly="1"/>
            </field>
        </field>
    </record>


</odoo>