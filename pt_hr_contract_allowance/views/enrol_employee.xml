<odoo>

    <record id="gs_enrol_employee_view_tree" model="ir.ui.view">
        <field name="name">gs.enrol.emloyee.view.tree</field>
        <field name="model">enrol.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cr"/>
                <field name="wol"/>
            </list>
        </field>
    </record>

    <record id="gs_enrol_employee_form_view" model="ir.ui.view">
        <field name="name">gs.enrol.employee.view.form</field>
        <field name="model">enrol.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                <field name="name"/>
                <field name="cr"/>
                <field name="wol"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gs_enrol_employee_action" model="ir.actions.act_window">
        <field name="name">Enrol Employee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">enrol.employee</field>
        <field name="view_mode">list,form</field>
    </record>
        <menuitem
        name="Enrol Employee"
        id="menu_enrol_employee_conf"
        action="gs_enrol_employee_action"
        parent="hr.menu_human_resources_configuration"
        sequence="20"
    />


</odoo>