<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

<!--    wizerd register payment -->
    <record id="view_account_payment_form_inherit10" model="ir.ui.view">
        <field name="name">account.payment.invoice.form.inherit.register</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="sale_persone_id"  attrs="{'required': [('partner_type', '!=', 'supplier')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_register_form_inherit31" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit5</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="sale_persone_payment_id"/>
            </xpath>
        </field>
    </record>
<!--        end -->
    </data>
</odoo>