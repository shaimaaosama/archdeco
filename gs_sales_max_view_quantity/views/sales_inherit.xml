<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gs_sales_max_view_quantity_product_template_form" model="ir.ui.view">
            <field name="name">product.template.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tooltip']" position="after">
                    <field name="is_max_view"/>
                    <field invisible="is_max_view == False" name="max_view"/>
                </xpath></field>
        </record>
        <record id="gs_sales_max_view_quantity_product_product_form" model="ir.ui.view">
            <field name="name">product.product.form.view</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tooltip']" position="after">
                    <field name="is_max_view"/>
                    <field invisible="is_max_view == False" name="max_view"/>
                </xpath></field>
        </record>
    </data>
</odoo>
