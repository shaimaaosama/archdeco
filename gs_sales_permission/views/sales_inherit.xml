<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field invisible="1" name="is_create_invoice"/>
                    <field invisible="1" name="is_send_by_email"/>
                    <field invisible="1" name="is_confirm"/>
                    <field invisible="1" name="is_cancel"/>
                    <field invisible="1" name="is_draft"/>
                    <field invisible="1" name="is_send_pro"/>
                    <field invisible="1" name="t_or_f" readonly="0"/>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d']" position="attributes">
                    <attribute name="invisible">invoice_status != 'to invoice' or is_create_invoice != True</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or is_cancel != True</attribute>
                </xpath>
                <xpath expr="//button[@name='action_draft']" position="attributes">
                    <attribute name="invisible">is_draft != True or state != 'cancel'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                    <attribute name="invisible">is_send_by_email != True</attribute>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send']" position="replace">
                    <button class="btn-primary" data-hotkey="g" invisible="is_send_by_email != True or state != 'draft'" name="action_quotation_send" string="Send by Email" type="object"/>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send'][last()]" position="replace">
                    <button data-hotkey="g" invisible="is_send_by_email != True or state not in ['sent', 'sale']" name="action_quotation_send" string="Send by Email" type="object"/>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][last()]" position="replace">
                    <button data-hotkey="v" invisible="t_or_f == True or is_confirm != True or state != 'draft'" name="action_confirm" string="Confirm" type="object"/>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][last()]" position="replace">
                    <button context="{'default_advance_payment_method': 'percentage'}" data-hotkey="q" invisible="invoice_status != 'no' or state != 'sale' or is_create_invoice != True" name="%(sale.action_view_sale_advance_payment_inv)d" string="Create Invoice" type="action"/>
                </xpath></field>
        </record>
