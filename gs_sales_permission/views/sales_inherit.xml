        <record id="sale_order_form_inherit02" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="gs_stock_from_sr.gs_sr_sale_order_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field invisible="1" name="create_delivery" readonly="0"/>
                    <field invisible="1" name="is_create_del"/>
                    <field invisible="1" name="delivered"/>
                </xpath>
                <xpath expr="//button[@name='action_create_delivery']" position="attributes">
                    <attribute name="invisible">create_delivery != True or is_delivery == True or delivered == True</attribute>
                </xpath></field>
        </record>
        <record id="sale_order_form_inherit03" model="ir.ui.view">
            <field name="name">sale.order.form.inherit03</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="quotation_revision.sale_order_inherited_view_quotation_revision"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_saleorder_id']" position="after">
                    <field invisible="1" name="is_revise"/>
                    <field invisible="1" name="is_set_so"/>
                </xpath>
                <xpath expr="//button[@name='so_revision_quote']" position="attributes">
                    <attribute name="invisible">is_revise != True</attribute>
                </xpath>
                <xpath expr="//button[@name='set_so']" position="attributes">
                    <attribute name="invisible">is_set_so != True</attribute>
                </xpath></field>
        </record>
        <record id="sale_order_form_inherit04" model="ir.ui.view">
            <field name="name">sale.order.form.inherit04</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="gs_customer_credit_limit.view_sale_order_confirm_inherit_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='t_or_f']" position="after">
                    <field invisible="1" name="is_confirm" readonly="0"/>
                    <field invisible="1" name="is_confirm_limit" readonly="0"/>
                    <field invisible="1" name="is_confirm_sale" readonly="0"/>
                </xpath>
                <xpath expr="//button[@name='action_sale_ok']" position="attributes">
                    <attribute name="invisible">t_or_f == True or is_confirm != True or state != 'draft'</attribute>
                </xpath>
                <xpath expr="//button[@name='set_credit_limit_state_also_if_has_due']" position="attributes">
                    <attribute name="invisible">t_or_f == False or is_confirm_limit != True or state != 'draft'</attribute>
                </xpath>
                <xpath expr="//button[@id='action_confirm_sale']" position="attributes">
                    <attribute name="invisible">is_confirm_sale != True or state != 'credit_limit'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_sale_ok'][last()]" position="replace">
                </xpath></field>
        </record>
        <record id="customer_limit_wizard_form_inherit" model="ir.ui.view">
            <field name="name">customer.limit.wizard.form.inherit05</field>
            <field name="model">customer.limit.wizard</field>
            <field name="inherit_id" ref="gs_customer_credit_limit.view_customer_limit_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_id']" position="after">
                    <field invisible="1" name="is_confirm_wiz_limit" readonly="0"/>
                </xpath>
                <xpath expr="//button[@name='set_credit_limit_state_also_if_has_due']" position="attributes">
                    <attribute name="invisible">t_or_f != True or is_confirm_wiz_limit != True</attribute>
                </xpath></field>
        </record>
    </data>
</odoo>
