<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgeede_stock_warehouse_inherit_form_view" model="ir.ui.view">
        <field name="name">sgeede.stock.warehouse.inherit.form.view</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <separator string="Permission to Send and Receive Products" colspan="4"/>
                    <field name="user_ids" nolabel="1" colspan="4">
                        <list>
                            <field name="name"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sgeede_view_move_inherit_tree_view" model="ir.ui.view">
        <field name="name">stock.move.inherit.tree.view</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="partner_id" string="Partner"/>
            </xpath>
        </field>
    </record>

    <record id="sgeede_view_move_inherit_form_view" model="ir.ui.view">
        <field name="name">stock.move.inherit.form.view</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_grp_col1']/field[@name='reference']" position="after">
                <field name="partner_id" string="Partner"/>
                <field name="get_partner" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="sgeede_view_move_line_inherit_tree_view" model="ir.ui.view">
        <field name="name">stock.move.line.inherit.tree.view</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="picking_partner_id" string="Partner"/>
            </xpath>
        </field>
    </record>

    <record id="sgeede_view_move_line_inherit_form_view" model="ir.ui.view">
        <field name="name">stock.move.line.inherit.form.view</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="picking_partner_id" string="Partner"/>
            </xpath>
        </field>
    </record>

