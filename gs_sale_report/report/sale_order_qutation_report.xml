                            </table>
                        </div>
                        <div t-if="o.note" style="float: left; width:60%; text-align:left">
                            <strong>
                                <u>Terms And Conditions</u>
                            </strong>
                            <br/>
                            <span t-field="o.note"/>
                        </div>

                        <div t-if="o.payment_term_id.note" style="float: left; width:60%; text-align:left">
