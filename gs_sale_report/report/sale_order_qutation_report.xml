<odoo>
    <template id="report_sale_order_document1">
        <t t-call="web.html_container">
            <t t-set="count" t-value="0"/>
            <t t-set="total_before_amount1" t-value="0"/>
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc.with_context(lang=lang)"/>
                <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">
                    <t t-call="gs_sale_report.custom_sale_order_header"/>
                    <style>
<!--                        @font-face {-->
<!--                        font-family: 'Arial';-->
<!--                        src: local('Cairo-Regular'), local('Cairo-Regular'),-->
<!--                        url(/gs_invoice_pdf_report/static/src/fonts/cairo/Cairo-Regular.ttf) format('opentype');-->
<!--                        }-->

                        .font_cairo{
                        font-family: Arial;
                        }

                        .gs_table {
                        border-collapse: collapse;
                        border: 0px solid #ddd;
                        float:right !important;
                        width:100%;
                        margin:auto;
                        }
                        .gs_table td {
                        height: 10px;
                        border-bottom: 1px solid #ddd;
                        vertical-align: middle;
                        font-size:16px;
                        padding:5;
                        }
                        gs_customer_info {
                        table-layout: fixed
                        }
                        .gs_customer_info td {
                        height: 10px;
                        vertical-align: middle;
                        padding:5;
                        }
                        .gs_customer_infor {
                        border-collapse: collapse;
                        }
                        .gs_customer_infor td {
                        vertical-align: middle;
                        }
                        .gs_customer_infor_td_vals{
                        float:left !important;text-align:left !important
                        }
                        gs_customer_info2{
                        border-collapse: collapse;
                        }
                        gs_customer_info2 tr td strong{font-color:#3B124C;}
                    </style>
                    <div class="page font_cairo">
                        <h5 class="text-center" style="margin-bottom:30px">
                            <div class="o_force_ltr" style="border-radius: 25px;background: #eef2f3; padding: 3px 0 3px 0;
                                        width:45%;border:3px solid;display:inline-block;">
                                <t t-if="doc.state=='draft'">
                                    <strong>Draft So-مسودة طلبية</strong>
                                </t>
                                <t t-if="doc.state=='sent'">
                                    <strong>Draft So-مسودة طلبية</strong>
                                </t>
                                <t t-if="doc.state=='waiting_for_approval'">
                                    <strong>Draft So-مسودة طلبية</strong>
                                </t>
                                <t t-if="doc.state =='sale'">
                                    <strong>Sale Order-طلبية</strong>
                                </t>
                                <t t-if="doc.state =='done'">
                                    <strong>Sale Order-طلبية</strong>
                                </t>
                                <t t-if="doc.state =='cancel'">
                                    <strong>Draft So-مسودة طلبية</strong>
                                </t>
                            </div>
                        </h5>
                        <div class="row p-3" style="direction:ltr;">
                            <div class="col-6" style="font-size:12px;">
                                <table class="mt-2 table table-borderless" style="width:100%;border:0;direction: ltr;">
                                    <tr>
                                        <td>
                                            <strong style="color:#3B124C;float:left">Customer</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span class="gs_customer_infor_td_vals" t-field="doc.partner_id.name"/>
                                        </td>
                                        <td>
                                            <strong style="color:#3B124C;float:right">العميل</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong style="color:#3B124C;float:left">Address</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span class="gs_customer_infor_td_vals" t-field="doc.partner_id.street"/>
                                        </td>
                                        <td>
                                            <strong style="color:#3B124C;float:right">العنوان</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong style="color:#3B124C;float:left">Phone/Fax</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span class="gs_customer_infor_td_vals" t-field="doc.partner_id.phone"/>
                                        </td>
                                        <td>
                                            <strong style="color:#3B124C;float:right">الهاتف/الفاكس</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong style="color:#3B124C;float:left">Comm.Reg.NO</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span t-field="doc.partner_id.cr_id" style="display:inline-block;"/>
                                        </td>
                                        <td>
                                            <strong style="color:#3B124C;float:right">السجل التجاري</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong style="color:#3B124C;float:left">VAT.Reg.NO</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span class="gs_customer_infor_td_vals" t-field="doc.partner_id.vat"/>
                                        </td>
                                        <td>
                                            <strong style="color:#3B124C;float:right">الرقم الضريبي</strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6" style="font-size:12px;">
                                <table class="table table-borderless" style="width:100%;border:0">
                                    <tr>
                                        <td style="text-align:left">
                                            <strong class="dir_ltr" style="color:#3B124C;">Date</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                                        </td>
                                        <td style="text-align:right">
                                            <strong class="dir_rtl" style="color:#3B124C;">التاريخ</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <strong class="dir_ltr" style="color:#3B124C;">Sale</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <strong t-field="doc.name"/>
                                        </td>
                                        <td style="text-align:right">
                                            <strong class="dir_rtl" style="color:#3B124C;">البيع</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <strong class="dir_ltr" style="color:#3B124C;">Date</strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span t-field="doc.validity_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                        </td>
                                        <td style="text-align:right">
                                            <strong class="dir_rtl" style="color:#3B124C;">تاريخ الصلاحية</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <strong style="display:inline-block;color:#3B124C;">Terms</strong>
                                        </td>
                                        <td style="text-align:center;font-size:12px">
                                            <span t-field="doc.payment_term_id"/>
                                        </td>
                                        <td style="text-align:right">
                                            <strong class="dir_rtl" style="color:#3B124C;">شروط الدفع</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left;width:25%">
                                            <strong style="display:inline-block;color:#3B124C;" class="dir_ltr">Sale
                                                Person
                                            </strong>
                                        </td>
                                        <td style="text-align:center">
                                            <span t-field="doc.user_id.name"/>
                                        </td>
                                        <td style="text-align:right">
                                            <strong class="dir_rtl" style="color:#3B124C;">مندوب المبيعات</strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <br/>
                        </div>
                        <!--  create the invoice table -->
                        <t t-set="seq" t-value="1"/>
                        <table class="text-center table table-borderless  mt-2" style="width:100%;border:0;direction: ltr;">
                            <thead style="background-color:#e1c793;color:#1a1919;padding:15px;">
                                <tr>
                                    <th style="width:5%; font-size:12px">
                                        <span>SN</span>
                                        <br/>
                                        <span style="padding-left:5px;">م</span>
                                    </th>
                                    <th name="th_description" style="width:45%; font-size:12px">
                                        <span>Description</span>
                                        <br/>
                                        <span>الوصف</span>
                                    </th>
                                    <th style="width:8%;" name="th_quantity">
                                        <span style="font-size:12px;">Quantity</span>
                                        <br/>
                                        <span style="font-size:12px;">الكمية</span>
                                    </th>
                                    <th style="width:8%;" name="th_quantity">
                                        <span style="font-size:12px;">Count</span>
                                        <br/>
                                        <span style="font-size:12px;">العدد</span>
                                    </th>
                                    <th name="th_priceunit">
                                        <strong style="font-size:12px;">Unit Price</strong>
                                        <br/>
                                        <strong style="font-size:12px;">سعر الوحدة</strong>
                                    </th>
                                    <th style="font-size:12px" name="th_price_unit2">
                                        <span style="">Disc</span>
                                        <br/>
                                        <span style="">الخصم</span>
                                    </th>
                                    <th style="font-size:12px;" name="th_taxes">
                                        <span>VAT</span>
                                        <br/>
                                        <span style="font-size:12px;">الضريبة</span>
                                    </th>
                                    <th style="font-size:12px" class="text-center" name="th_subtotal">
                                        <span groups="account.group_show_line_subtotals_tax_excluded">Subtotal
                                        </span>
                                        <br/>
                                        <span>الاجمالي</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                       groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                       groups="account.group_show_line_subtotals_tax_included"/>
                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type">
                                            <td name="seq" style="width:4%;">
                                                <span t-esc="seq"/>
                                                <t t-set="seq" t-value="seq+1"/>
                                            </td>
                                            <td name="td_name">
                                                <span style='float:left;font-size:12px;text-align:left'
                                                      t-options="{'widget': 'text'}"
                                                      t-field="line.name"/>
                                            </td>
                                            <td style="font-size:12px;width:8%;" name="td_quantity">
                                                <span t-field="line.product_uom_qty"/>
                                                <br/>
                                                <span t-field="line.product_uom"/>
                                            </td>
                                            <td style="font-size:12px;width:8%;">
                                                <span t-esc="'%.0f'% line.sh_sec_qty" groups="uom.group_uom"/>
                                                <br/>
                                                <span t-esc="line.sh_sec_uom.name" groups="uom.group_uom"/>
                                            </td>

                                            <td name="td_priceunit" style="width:10%;">
                                                <span class="text-nowrap" t-field="line.price_unit"/>
                                            </td>
                                            <td style="width:10%;">
                                                <span class="text-nowrap" t-field="line.discount"/>%
                                            </td>
                                            <!--                                            <td t-if="display_discount" class="text-right"-->
                                            <!--                                                groups="product.group_discount_per_so_line">-->
                                            <!--                                                <span t-field="line.discount"/>-->
                                            <!--                                            </td>-->
                                            <td name="td_taxes">
                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                            </td>

                                            <td class="o_price_total">
                                                <span class="text-nowrap" t-field="line.price_subtotal"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td name="td_section_line" colspan="99">
                                                <span style="float:left" t-field="line.name"
                                                      t-options="{'widget': 'text'}"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td name="td_note_line" colspan="99">
                                                <span style="float:left" t-options="{'widget': 'text'}"
                                                      t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                        <!--                                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">-->
                                        <tr class="is-subtotal">
                                            <td colspan="99">
                                                <strong style="float:left" class="mr16">Subtotal</strong>
                                                <span style="float:left"
                                                      t-esc="current_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <!--                                        </t>-->
                                    </t>
                                    <!--                                    total bf dis -->
                                    <t t-set="total_before_amount1"
                                       t-value="total_before_amount1+(line.product_uom_qty*line.price_unit)"/>
                                    <!--                            end         -->
                                </t>
                            </tbody>
                        </table>
                        <div id="total" style="float: right; width:60%; text-align:left">
                            <table class="table " style="direction:ltr;border:0px;page-break-inside: avoid;">
                                <t t-set="disc1" t-value="total_before_amount1-o.amount_untaxed"/>
                                <tr style="">
                                    <td>
                                        <span style="color:#3B124C;">Total Be.Disc الاجمالي قبل الخصم
                                        </span>
                                    </td>
                                    <td class="text-left">
                                        <span class="gs_customer_infor_td_vals" t-esc="total_before_amount1"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="border-black o_subtotal">
                                    <td>
                                        <span style="color:#3B124C;">Disc الخصم
                                        </span>
                                    </td>
                                    <td class="text-left">
