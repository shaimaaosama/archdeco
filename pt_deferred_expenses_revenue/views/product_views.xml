<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_deferred" model="ir.ui.view">
        <field name="name">product.template.form.inherit.deferred</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_income_id']" position="after">
                <group string="Deferred Accounts" >
                    <field name="property_account_deferred_expense_id"/>
                    <field name="property_account_deferred_revenue_id"/>
\                </group>
            </xpath>
        </field>
    </record>
</odoo>
