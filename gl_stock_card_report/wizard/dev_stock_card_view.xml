<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_stock_card_form" model="ir.ui.view">
        <field name="name">view.dev.stock.card.form</field>
        <field name="model">dev.stock.card</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Stock Card Report">
                <sheet>
                    <group string="Dates">
                        <group>
                            <field name="start_date" required="1"/>
                        </group>
                        <group>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <group string="Location / Company">
                        <group>
                            <field name="warehouse_id" options="{'no_create':true,'no_open':true}"/>
                            <field invisible="warehouse_id == False" name="location_id" options="{'no_create':true,'no_open':true}" required="warehouse_id == True"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Products / Category">
                        <field name="filter_by"/>
                        <field invisible="filter_by != 'category'" name="category_id" required="filter_by == 'category'"/>
                        <field invisible="filter_by != 'product'" name="product_ids" options="{'no_create':true,'no_open':true}" required="filter_by == 'product'" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <!--                            <button name="print_pdf" string="PDF" type="object" class="btn-primary"/>-->
                        <!--                            or-->
                        <button class="btn-primary" name="action_generate_excel" string="Excel" type="object"/>
                        or
                        <button class="btn-default" special="cancel" string="Cancel"/>
                    </footer>
                </sheet>
            </form></field>
    </record>
    <record id="action_dev_stock_card_report" model="ir.actions.act_window">
        <field name="name">Stock Card Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.stock.card</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem action="action_dev_stock_card_report" id="menu_dev_stock_card_report" name="Stock Card Report" parent="stock.menu_warehouse_report" sequence="10"/>
</odoo>
