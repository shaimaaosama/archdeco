<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.cron" id="check_vacation_cron">
            <field name="name">Check Vacation</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="type">ir.actions.server</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="state">code</field>
            <field name="code">model._cron_check_vacation()</field>
        </record>
        <record model="ir.cron" id="check_vacation_end_cron">
            <field name="name">Check Vacation End</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="type">ir.actions.server</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="state">code</field>
            <field name="code">model._cron_check_vacation_end()</field>
        </record>

    </data>
</odoo>