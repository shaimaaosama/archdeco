<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="saleorder_document_inherit_so_delivery_link_invoice" inherit_id="gs_invoice_pdf_report.report_sale_invoice_document1">
        <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
            <tbody class="invoice_tbody" style="border: 1px solid #b5b5b5;padding: 6px;">
                <t t-set="current_subtotal" t-value="0"/>
                <t t-set="lines"
                   t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                <t t-foreach="lines" t-as="line">
                    <t t-if="line.display_type in ('line_section', 'line_note') or not line.sale_line_ids or sum(line.sale_line_ids.mapped('product_uom_qty'))">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                        />
                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section'
                         else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'product'"
                               name="account_invoice_line_accountable">
                                <td name="seq" style="width:4%;border: 1px solid #b5b5b5;">
                                    <span t-esc="seq"/>
                                    <t t-set="seq" t-value="seq+1"/>
                                </td>
                                <td name="account_invoice_line_name" style="border: 1px solid #b5b5b5;padding-left:4px;">
                                    <span style='font-size:12px;float:left;text-align:left'
                                          t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <td style="font-size:12px;width:8%;border: 1px solid #b5b5b5;">
                                    <span t-field="line.quantity"/>
                                    <br/>
                                    <span t-field="line.product_uom_id"/>
                                </td>
                                <td style="font-size:12px;width:8%;border: 1px solid #b5b5b5;">
                                    <span t-esc="'%.0f'% line.sh_sec_qty"/>
                                    <br/>
                                    <span t-esc="line.sh_sec_uom.name"/>
                                </td>

                                <td style="width:10%;border: 1px solid #b5b5b5;">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget': 'float', 'precision': 3}"/>
                                </td>
                                <td style="width:10%;border: 1px solid #b5b5b5;">
                                    <span class="text-nowrap" t-field="line.discount"/>%
                                </td>
                                <td style="border: 1px solid #b5b5b5;">
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"
                                          id="line_tax_ids"/>
                                </td>
                                <td class="o_price_total" style="border: 1px solid #b5b5b5;">
                                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" style="border: 1px solid #b5b5b5;">
                                    <span style="float:left" t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" style="border: 1px solid #b5b5b5;">
                                    <span style="float:left" t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal">
                                <td colspan="99">
                                    <strong style="float:left" class="mr16">Subtotal</strong>
                                    <span style="float:left"
                                          t-esc="current_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                        <t t-set="total_before_amount1" t-value="total_before_amount1+(line.price_unit*line.quantity)"/>
                    </t>
                </t>
            </tbody>
        </xpath>
    </template>

    <!-- Show room invoice -->
    <template id="saleorder_document_inherit_so_delivery_link_show_room" inherit_id="gs_invoice_pdf_report.report_show_room_invoice_document1">
        <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
            <tbody class="invoice_tbody">
                <t t-set="current_subtotal" t-value="0"/>
                <t t-set="lines"
                   t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                <t t-foreach="lines" t-as="line">
                    <t t-if="line.display_type in ('line_section', 'line_note') or not line.sale_line_ids or sum(line.sale_line_ids.mapped('product_uom_qty'))">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                           groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                           groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section'
                         else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                <td name="seq" style="width:4%;">
                                    <span t-esc="seq"/>
                                    <t t-set="seq" t-value="seq+1"/>

                                </td>
                                <td name="account_invoice_line_name">
                                    <span style='font-size:12px;'
                                          t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <td style="font-size:12px;width:8%;">
                                    <span t-field="line.quantity"/>
                                    <br/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td style="font-size:12px;width:8%;">
                                    <span t-esc="'%.0f'% line.sh_sec_qty" groups="uom.group_uom"/>
                                    <br/>
                                    <span t-esc="line.sh_sec_uom.name" groups="uom.group_uom"/>
                                </td>
                                <td style="width:10%;">
                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                </td>
                                <td style="width:10%;">
                                    <span class="text-nowrap" t-field="line.discount"/>%
                                </td>
                                <td style="width:10%;">
                                    <span class="text-nowrap"
                                          t-esc="(line.price_unit)-(line.price_unit*(line.discount/100))"/>
                                </td>
                                <td>
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"
                                          id="line_tax_ids"/>
                                </td>
                                <td class="o_price_total">
                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                          />

                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span style="float:left" t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span style="float:left" t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal">
                                <td colspan="99">
                                    <strong style="float:left" class="mr16">Subtotal</strong>
                                    <span style="float:left"
                                          t-esc="current_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                        <t t-set="total_before_amount1" t-value="total_before_amount1+(line.price_unit*line.quantity)"/>
                    </t>
                </t>
            </tbody>
        </xpath>
    </template>
</odoo>
