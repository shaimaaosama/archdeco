<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_mobile_token_view_list" model="ir.ui.view">
        <field name="name">hr.employee.mobile.token.list</field>
        <field name="model">hr.employee.mobile.token</field>
        <field name="arch" type="xml">
            <list string="Mobile App Sessions" default_order="create_date desc" duplicate="false" create="false">
                <field name="employee_id"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="last_used"/>
                <field name="expires_at"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_mobile_token_view_search" model="ir.ui.view">
        <field name="name">hr.employee.mobile.token.search</field>
        <field name="model">hr.employee.mobile.token</field>
        <field name="arch" type="xml">
            <search string="Mobile App Sessions">
                <field name="employee_id"/>
                <field name="device_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Revoked" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_employee_mobile_token_action" model="ir.actions.act_window">
        <field name="name">Mobile App Sessions</field>
        <field name="res_model">hr.employee.mobile.token</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No mobile app sessions yet.
            </p>
            <p>
                Employees get a session token here after signing in to the mobile app.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_employee_mobile_token"
              name="Mobile App Sessions"
              parent="hr_attendance.menu_hr_attendance_root"
              action="hr_employee_mobile_token_action"
              groups="hr_attendance.group_hr_attendance_officer"
              sequence="98"/>

</odoo>
