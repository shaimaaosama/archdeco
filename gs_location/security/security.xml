<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_moves_location_restriction" model="ir.rule">
            <field name="name">Stock Moves Location Restriction</field>
            <field ref="stock.model_stock_move" name="model_id"/>
            <field name="domain_force">[('location_id', 'in', user.stock_location_ids.ids),('location_dest_id', 'in', user.stock_location_ids.ids)]</field>
        </record>

        <record id="product_moves_location_restriction" model="ir.rule">
            <field name="name">Product Moves Location Restriction</field>
            <field ref="stock.model_stock_move_line" name="model_id"/>
            <field name="domain_force">[('location_id', 'in', user.stock_location_ids.ids),('location_dest_id', 'in', user.stock_location_ids.ids)]</field>
        </record>

    </data>
</odoo>