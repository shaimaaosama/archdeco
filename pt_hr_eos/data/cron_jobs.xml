<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="eos_monthly_cron" model="ir.cron">
            <field name="name">EOS Monthly</field>
            <field name="model_id" ref="model_gs_eos_monthly"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model._check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="eos_monthly_cron_from_hired_date" model="ir.cron">
            <field name="name">EOS Monthly From Hired Date</field>
            <field name="model_id" ref="model_gs_eos_monthly"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.create_eos_monthly_from_hired_date()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>


    </data>
</odoo>
