<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gosisaudi" model="ir.ui.view">
            <field name="name">gosi.paysliptree</field>
            <field name="model">gosi.payslip</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Service Execute">
                    <field name="employee_id"/>
                    <field name="department"/>
                    <field name="position"/>
                    <field name="nationality"/>
                    <field name="gos_numb"/>
                    <field name="issued_dat"/>
                </list>
            </field>
        </record>
        <record id="gosi_payslip3" model="ir.ui.view">
            <field name="name">gosi.payslip_name</field>
            <field name="model">gosi.payslip</field>
            <field name="arch" type="xml">
               <form string="Service Execute">
                   <sheet>
                       <group col="4" colspan="4">
                        <group string="Employee Details" col="2" colspan="2">
                            <field name="employee_id"/>
                            <field name="department"/>
                            <field name="position"/>
                            <field name="nationality"/>
                        </group>
                        <group string="GOSI Details" col="2" colspan="2">
                            <field name="type_gosi"/>
                            <field name="dob"/>
                            <field name="gos_numb"/>
                            <field name="issued_dat"/>
                        </group>
                       </group>
                   </sheet>
                   <chatter/>
               </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_view_employee_gosi">
            <field name="name">Employee GOSI</field>
            <field name="res_model">gosi.payslip</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_no_content_create">Create new record
                </p>
            </field>
        </record>
<!--        <menuitem id="gosi_employee" name="GOSI Register" parent="hr_work_entry_contract.menu_hr_payroll_configuration"-->
<!--                  action="action_view_employee_gosi" sequence="100"/>-->

         <record model="ir.ui.view" id="hr_employee_inherited_form_view">
            <field name="name">hr.employees.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                    <xpath expr="//field[@name='work_email']" position="after">
                        <field name="is_gosi" widget="boolean_toggle" invisible="1"/>
                    </xpath>
                     <xpath expr="//page[@name='hr_settings']" position="after">
                         <field name="limit" invisible="1"/>
                         <page name="gosi_info" string="GOSI Information" invisible="'is_gosi' == False or 'limit' == False">
                             <group>
                                 <group>
                                     <field name="gosi_conf" invisible="1"/>
                                     <field name="run_com" invisible="1"/>
                                     <field name="type" />
                                     <field name="gosi_number"/>
                                     <field name="issue_date"/>
                                     <field name="company_share_per"/>
                                     <field name="company_share_amount"/>
                                     <field name="Saudah" readonly="type != 'saudi'"/>
                                 </group>
                                 <group>
                                     <field name="employee_share_per"/>
                                     <field name="employee_share_amount"/>
                                     <field name="gosi_salary_amount"/>
                                     <field name="maximum_gosi_salary"/>
                                 </group>
                             </group>
                         </page>
                     </xpath>
                     <xpath expr="//page[@name='personal_information']//field[@name='place_of_birth']" position="after">
                             <field name="age"/>
                     </xpath>

            </field>
         </record>

        <record model="ir.ui.view" id="hr_payslip_inherited_form_view">
            <field name="name">hr.payslip.form.view</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                     <xpath expr="//field[@name='struct_id']" position="after">
                         <!--<field name="gosi_no"/>-->
                         <field name="employee_share_amount" invisible="1"/>
                     </xpath>
            </field>
         </record>
    </data>
</odoo>