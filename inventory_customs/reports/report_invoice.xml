<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="saleorder_document_inherit_so_delivery_link_invoice"
              inherit_id="gs_invoice_pdf_report.report_sale_invoice_document1">

        <xpath expr="//thead" position="replace">
            <thead style="background-color:#e1c793;color:#1a1919; border: 1px solid #b5b5b5;">
                <tr>
                    <th style="width:3%; font-size:12px; border: 1px solid #b5b5b5;">
                        <span>SN</span>
                        <br/>
                        <span style="padding-left:5px;">م</span>
                    </th>

                    <th name="th_description"
                        style="width:30%; font-size:12px; border: 1px solid #b5b5b5;">
                        <span>Product/Service</span>
                        <br/>
                        <span>منتج/خدمة</span>
                    </th>

                    <th style="width:8%; border: 1px solid #b5b5b5;"
                        name="th_quantity">
                        <span style="font-size:12px;">Quantity</span>
                        <br/>
                        <span style="font-size:12px;">الكمية</span>
                    </th>

                    <th style="width:8%; border: 1px solid #b5b5b5;"
                        name="th_count">
                        <span style="font-size:12px;">Count</span>
                        <br/>
                        <span style="font-size:12px;">العدد</span>
                    </th>

                    <th name="th_priceunit"
                        style="border: 1px solid #b5b5b5;">
                        <span style="font-size:12px;">Unit Price</span>
                        <br/>
                        <span style="font-size:12px;">سعر الوحدة</span>
                    </th>

                    <th style="width:5%; font-size:12px; border: 1px solid #b5b5b5;"
                        name="th_price_unit2">
                        <span>Disc</span>
                        <br/>
                        <span>الخصم</span>
                    </th>

                    <th style="font-size:12px; border: 1px solid #b5b5b5; width:12%;"
                        class="text-center"
                        name="th_subtotal">
                        <span>Subtotal (Excl. VAT)</span>
                        <br/>
                        <span>الاجمالي قبل الضريبة</span>
                    </th>

                    <th style="font-size:12px; border: 1px solid #b5b5b5;"
                        class="text-center"
                        name="th_taxes">
                        <span>VAT</span>
                        <br/>
                        <span style="font-size:11px;">الضريبة</span>
                    </th>

                    <th style="font-size:12px; border: 1px solid #b5b5b5; width:12%;"
                        class="text-center"
                        name="th_total">
                        <span>Subtotal (Incl. VAT)</span>
                        <br/>
                        <span>الاجمالي شامل الضريبة</span>
                    </th>
                </tr>
            </thead>
        </xpath>

        <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
            <tbody class="invoice_tbody"
                   style="border: 1px solid #b5b5b5; padding: 6px;">

                <t t-set="current_subtotal" t-value="0"/>

                <t t-set="lines"
                   t-value="o.invoice_line_ids.sorted(
                       key=lambda l: (
                           -l.sequence,
                           l.date,
                           l.move_name,
                           -l.id
                       ),
                       reverse=True
                   )"/>

                <t t-foreach="lines" t-as="line">

                    <t t-if="
                        line.display_type in ('line_section', 'line_note')
                        or not line.sale_line_ids
                        or line.sale_line_ids.filtered('is_downpayment')
                        or sum(line.sale_line_ids.mapped('product_uom_qty')) != 0
                    ">

                        <t t-set="current_subtotal"
                           t-value="current_subtotal + line.price_subtotal"/>

                        <tr t-att-class="
                            'bg-200 font-weight-bold o_line_section'
                            if line.display_type == 'line_section'
                            else 'font-italic o_line_note'
                            if line.display_type == 'line_note'
                            else ''
                        ">

                            <t t-if="line.display_type == 'product'"
                               name="account_invoice_line_accountable">

                                <td name="seq"
                                    style="width:4%; border: 1px solid #b5b5b5;">
                                    <span t-esc="seq"/>
                                    <t t-set="seq" t-value="seq + 1"/>
                                </td>

                                <td name="account_invoice_line_name"
                                    style="border: 1px solid #b5b5b5; padding-left:4px;">
                                    <span style="font-size:12px; float:left; text-align:left;"
                                          t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>

                                <td style="font-size:12px; width:8%; border: 1px solid #b5b5b5;">
                                    <span t-field="line.quantity"/>
                                    <br/>
                                    <span t-field="line.product_uom_id"/>
                                </td>

                                <td style="font-size:12px; width:8%; border: 1px solid #b5b5b5;">
                                    <span t-esc="'%.0f' % (line.sh_sec_qty or 0.0)"/>
                                    <br/>
                                    <span t-esc="line.sh_sec_uom.name if line.sh_sec_uom else ''"/>
                                </td>

                                <td style="width:10%; border: 1px solid #b5b5b5;">
                                    <span t-field="line.price_unit"
                                          t-options="{
                                              'widget': 'float',
                                              'precision': 3
                                          }"/>
                                </td>

                                <td style="width:10%; border: 1px solid #b5b5b5;">
                                    <span class="text-nowrap"
                                          t-field="line.discount"/>%
                                </td>

                                <td class="o_price_total"
                                    style="border: 1px solid #b5b5b5;">
                                    <span class="text-nowrap"
                                          t-field="line.price_subtotal"/>
                                </td>

                                <td style="border: 1px solid #b5b5b5;">
                                    <span t-esc="', '.join(
                                        map(
                                            lambda x: x.description or x.name,
                                            line.tax_ids
                                        )
                                    )"
                                          id="line_tax_ids"/>
                                </td>

                                <td class="o_price_total"
                                    style="border: 1px solid #b5b5b5;">
                                    <span class="text-nowrap"
                                          t-field="line.price_total"/>
                                </td>

                            </t>

                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99"
                                    style="border: 1px solid #b5b5b5;">
                                    <span style="float:left;"
                                          t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>

                                <t t-set="current_section"
                                   t-value="line"/>

                                <t t-set="current_subtotal"
                                   t-value="0"/>
                            </t>

                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99"
                                    style="border: 1px solid #b5b5b5;">
                                    <span style="float:left;"
                                          t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                            </t>

                        </tr>

                        <t t-if="
                            current_section
                            and (
                                line_last
                                or lines[line_index + 1].display_type == 'line_section'
                            )
                        ">
                            <tr class="is-subtotal">
                                <td colspan="99">
                                    <strong style="float:left;"
                                            class="mr16">
                                        Subtotal
                                    </strong>

                                    <span style="float:left;"
                                          t-esc="current_subtotal"
                                          t-options="{
                                              'widget': 'monetary',
                                              'display_currency': o.currency_id
                                          }"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="line.display_type == 'product'">
                            <t t-set="total_before_amount1"
                               t-value="
                                   total_before_amount1
                                   + (line.price_unit * line.quantity)
                               "/>
                        </t>

                    </t>
                </t>
            </tbody>
        </xpath>

        <xpath expr="//div[@id='total']" position="replace">
            <div id="total"
                 style="float:right; width:80%;">

                <table class="gs_table"
                       style="
                           direction:ltr;
                           border:1px solid #b5b5b5;
                           page-break-inside:avoid;
                       ">

                    <t t-set="disc1"
                       t-value="total_before_amount1 - o.amount_untaxed"/>

                    <tr>
                        <td style="padding:4px; text-align:left; width:70%;">
                            <span style="color:#000000;">
                                Total Before Discount
                                الاجمالي قبل الخصم
                            </span>
                        </td>

                        <td style="text-align:center; width:30%;">
                            <span t-esc="total_before_amount1"
                                  t-options="{
                                      'widget': 'monetary',
                                      'display_currency': o.currency_id
                                  }"/>
                        </td>
                    </tr>

                    <tr class="border-black o_subtotal">
                        <td style="padding:4px; text-align:left; width:70%;">
                            <span style="color:#000000;">
                                Discount الخصم
                            </span>
                        </td>

                        <td style="text-align:center; width:30%;">
                            <span t-esc="disc1"
                                  t-options="{
                                      'widget': 'monetary',
                                      'display_currency': o.currency_id
                                  }"/>
                        </td>
                    </tr>

                    <tr class="border-black o_subtotal">
                        <td style="padding:4px; text-align:left; width:70%;">
                            <span style="color:#000000;">
                                Total After Discount (Excl. VAT)
                                الاجمالي بعد الخصم وقبل الضريبة
                            </span>
                        </td>

                        <td style="text-align:center; width:30%;">
                            <span t-field="o.amount_untaxed"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:4px; text-align:left; width:70%;">
                            <span style="color:#000000;">
                                VAT ضريبة القيمة المضافة
                            </span>
                        </td>

                        <td style="text-align:center; width:30%;">
                            <span t-field="o.amount_tax"/>
                        </td>
                    </tr>

                    <tr class="border-black o_total">
                        <td style="padding:4px; text-align:left; width:70%;">
                            <span style="color:#000000;">
                                Total (Incl. VAT)
                                الاجمالي شامل الضريبة
                            </span>
                        </td>

                        <td style="padding:4px; text-align:center; width:30%;">
                            <strong t-field="o.amount_total"/>
                        </td>
                    </tr>

                    <tr class="border-black o_total">
                        <td class="text-center" colspan="2">

                            <div style="
                                text-align:center;
                                border-radius:25px;
                                background:#eef2f3;
                                padding:3px 0;
                                width:100%;
                                border:2px solid #38383d;
                                display:inline-block;
                                font-size:14px;
                            ">
                                <strong style="
                                    margin:0 8px;
                                    text-align:center;
                                    font-size:14px;
                                "
                                        t-esc="o.amount_text_arabic(o.amount_total)"/>
                            </div>

                            <div style="
                                text-align:center;
                                border-radius:25px;
                                background:#eef2f3;
                                padding:3px 0;
                                width:100%;
                                border:2px solid #38383d;
                                display:inline-block;
                                font-size:14px;
                            ">
                                <strong style="
                                    margin:0 8px;
                                    text-align:center;
                                    font-size:14px;
                                "
                                        t-esc="o.currency_id.amount_to_text(
                                            o.amount_total
                                        )"/>
                            </div>

                        </td>
                    </tr>

                    <t t-if="print_with_payments">
                        <t t-if="o.payment_state != 'invoicing_legacy'">

                            <t t-set="payments_vals"
                               t-value="
                                   o.sudo()._get_reconciled_info_JSON_values()
                               "/>

                            <t t-foreach="payments_vals"
                               t-as="payment_vals">

                                <tr>
                                    <td>
                                        <i class="
                                            oe_form_field
                                            text-left
                                            oe_payment_label
                                        ">
                                            Paid on

                                            <t t-esc="payment_vals['date']"
                                               t-options="{'widget': 'date'}"/>
                                        </i>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="payment_vals['amount']"
                                              t-options="{
                                                  'widget': 'monetary',
                                                  'display_currency': o.currency_id
                                              }"/>
                                    </td>
                                </tr>

                            </t>

                            <t t-if="len(payments_vals) > 0">
                                <tr class="border-black">
                                    <td>
                                        <strong>Amount Due</strong>
                                    </td>

                                    <td class="text-left">
                                        <span t-field="o.amount_residual"/>
                                    </td>
                                </tr>
                            </t>

                        </t>
                    </t>

                </table>
            </div>
        </xpath>

    </template>


    <!-- Show Room Invoice Report -->
    <template id="saleorder_document_inherit_so_delivery_link_show_room"
              inherit_id="gs_invoice_pdf_report.report_show_room_invoice_document1">

        <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
            <tbody class="invoice_tbody">

                <t t-set="current_subtotal" t-value="0"/>

                <t t-set="lines"
                   t-value="o.invoice_line_ids.sorted(
                       key=lambda l: (
                           -l.sequence,
                           l.date,
                           l.move_name,
                           -l.id
                       ),
                       reverse=True
                   )"/>

                <t t-foreach="lines" t-as="line">

                    <!-- Down payment lines are included here -->
                    <t t-if="
                        line.display_type in ('line_section', 'line_note')
                        or not line.sale_line_ids
                        or line.sale_line_ids.filtered('is_downpayment')
                        or sum(line.sale_line_ids.mapped('product_uom_qty')) != 0
                    ">

                        <t t-set="current_subtotal"
                           t-value="
                               current_subtotal + line.price_subtotal
                           "
                           groups="
                               account.group_show_line_subtotals_tax_excluded
                           "/>

                        <t t-set="current_subtotal"
                           t-value="
                               current_subtotal + line.price_total
                           "
                           groups="
                               account.group_show_line_subtotals_tax_included
                           "/>

                        <tr t-att-class="
                            'bg-200 font-weight-bold o_line_section'
                            if line.display_type == 'line_section'
                            else 'font-italic o_line_note'
                            if line.display_type == 'line_note'
                            else ''
                        ">

                            <t t-if="line.display_type == 'product'"
                               name="account_invoice_line_accountable">

                                <td name="seq"
                                    style="width:4%;">
                                    <span t-esc="seq"/>
                                    <t t-set="seq" t-value="seq + 1"/>
                                </td>

                                <td name="account_invoice_line_name">
                                    <span style="font-size:12px;"
                                          t-field="line.product_id.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>

                                <td style="font-size:12px; width:8%;">
                                    <span t-field="line.quantity"/>
                                    <br/>
                                    <span t-field="line.product_uom_id"
                                          groups="uom.group_uom"/>
                                </td>

                                <td style="font-size:12px; width:8%;">
                                    <span t-esc="
                                        '%.0f' % (line.sh_sec_qty or 0.0)
                                    "
                                          groups="uom.group_uom"/>
                                    <br/>

                                    <span t-esc="
                                        line.sh_sec_uom.name
                                        if line.sh_sec_uom
                                        else ''
                                    "
                                          groups="uom.group_uom"/>
                                </td>

                                <td style="width:10%;">
                                    <span class="text-nowrap"
                                          t-field="line.price_unit"/>
                                </td>

                                <td style="width:10%;">
                                    <span class="text-nowrap"
                                          t-field="line.discount"/>%
                                </td>

                                <td style="width:10%;">
                                    <span class="text-nowrap"
                                          t-esc="
                                              line.price_unit
                                              - (
                                                  line.price_unit
                                                  * (
                                                      line.discount / 100
                                                  )
                                              )
                                          "/>
                                </td>

                                <td>
                                    <span t-esc="', '.join(
                                        map(
                                            lambda x: x.description or x.name,
                                            line.tax_ids
                                        )
                                    )"
                                          id="showroom_line_tax_ids"/>
                                </td>

                                <td class="o_price_total">
                                    <span class="text-nowrap"
                                          t-field="line.price_subtotal"/>
                                </td>

                            </t>

                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span style="float:left;"
                                          t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>

                                <t t-set="current_section"
                                   t-value="line"/>

                                <t t-set="current_subtotal"
                                   t-value="0"/>
                            </t>

                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span style="float:left;"
                                          t-field="line.name"
                                          t-options="{'widget': 'text'}"/>
                                </td>
                            </t>

                        </tr>

                        <t t-if="
                            current_section
                            and (
                                line_last
                                or lines[line_index + 1].display_type == 'line_section'
                            )
                        ">
                            <tr class="is-subtotal">
                                <td colspan="99">
                                    <strong style="float:left;"
                                            class="mr16">
                                        Subtotal
                                    </strong>

                                    <span style="float:left;"
                                          t-esc="current_subtotal"
                                          t-options="{
                                              'widget': 'monetary',
                                              'display_currency': o.currency_id
                                          }"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="line.display_type == 'product'">
                            <t t-set="total_before_amount1"
                               t-value="
                                   total_before_amount1
                                   + (line.price_unit * line.quantity)
                               "/>
                        </t>

                    </t>
                </t>

            </tbody>
        </xpath>

    </template>

</odoo>