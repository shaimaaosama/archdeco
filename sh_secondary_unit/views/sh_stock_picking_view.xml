<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_view_stock_return_picking_form" model="ir.ui.view">
        <field name="name">sh.stock.return.picking.form.view</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_return_moves']/list/field[@name='quantity']" position="after">
                <field invisible="1" name="sh_is_secondary_unit" column_invisible="1"/>
                <field name="sh_sec_qty"/>
                <field name="sh_sec_uom"/>
            </xpath></field>
    </record>
    <record id="sh_stock_picking_form_view" model="ir.ui.view">
        <field name="name">sh.stock.picking.form.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']" position="after">
                <field invisible="1" name="sh_is_secondary_unit" column_invisible="1"/>
                <field force_save="1" groups="sh_secondary_unit.group_secondary_unit_inventory" name="sh_sec_qty" readonly="1"/>
                <field force_save="1" groups="sh_secondary_unit.group_secondary_unit_inventory" name="sh_sec_uom" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='product_uom']" position="after">
                <field groups="sh_secondary_unit.group_secondary_unit_inventory" name="sh_sec_done_qty" readonly="is_quantity_done_editable == False"/>
            </xpath>
<!--            <xpath expr="//field[@name='move_line_ids_without_package']" position="replace">-->
<!--                <field context="{'tree_view_ref': 'stock.view_stock_move_line_detailed_operation_tree', 'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}" invisible="show_reserved == False" name="move_line_ids_without_package" readonly="show_operations == False or state == 'cancel' or (state == 'done' and is_locked == True)">-->
<!--                    <list>-->
<!--                        <field invisible="1" name="picking_id"/>-->
<!--                        <field name="product_id"/>-->
<!--                        <field groups="stock.group_production_lot" name="lot_id"/>-->
<!--                        <field name="product_uom_qty"/>-->
<!--                        <field name="qty_done"/>-->
<!--                        <field groups="uom.group_uom" name="product_uom_id" options="{'no_open': True, 'no_create': True}" string="Unit of Measure"/>-->
<!--                        <field force_save="1" groups="sh_secondary_unit.group_secondary_unit_inventory" name="sh_sec_qty" readonly="1"/>-->
<!--                        <field force_save="1" groups="sh_secondary_unit.group_secondary_unit_inventory" name="sh_sec_uom" readonly="1"/>-->
<!--                    </list></field>-->
<!--            </xpath>-->
        </field>
    </record>
</odoo>
