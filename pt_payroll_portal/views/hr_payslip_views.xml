<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add portal visibility field to payslip form -->
    <record id="hr_payslip_view_form_inherit_portal" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.portal</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='credit_note']" position="after">
                <field name="portal_visible"/>
                <field name="access_token" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

    <!-- Add portal visibility filter to payslip search view -->
    <record id="hr_payslip_view_search_inherit_portal" model="ir.ui.view">
        <field name="name">hr.payslip.view.search.inherit.portal</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='done']" position="after">
                <filter string="Portal Visible" name="portal_visible" domain="[('portal_visible', '=', True)]"/>
                <filter string="Portal Hidden" name="portal_hidden" domain="[('portal_visible', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
