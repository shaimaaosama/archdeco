<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <template id="report_payslip_extended" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//div[@id='infos_table']" position="inside">
            <table name="payslip-header-info" class="table table-sm table-bordered mb-3">
                <tr>
                    <td class="w-25"><strong>Payslip Number</strong></td>
                    <td class="w-25"><strong>Batch Name</strong></td>
                    <td class="w-25"><strong>Company</strong></td>
                    <td class="w-25"><strong>Status</strong></td>
                </tr>
                <tr>
                    <td><span t-field="o.number"/></td>
                    <td><span t-field="o.payslip_run_id.name"/></td>
                    <td><span t-field="o.company_id.name"/></td>
                    <td><span t-field="o.state" class="text-capitalize"/></td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='infos_table']" position="after">
            <table class="table table-sm">
                <tr>
                    <td class="w-25"><strong>Basic Salary (<span class="text-capitalize" t-out="o.contract_id.wage_type"/>)</strong></td>
                    <td style="color:#875A7B" class="w-25">
                        <span t-out="o.contract_id._get_contract_wage()"
                              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                    </td>
                    <td class="w-25"><strong>Gross Wage</strong></td>
                    <td style="color:#875A7B" class="w-25">
                        <span t-field="o.gross_wage"
                              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="w-25"><strong>Net Wage</strong></td>
                    <td style="color:#875A7B" class="w-25" colspan="3">
                        <span t-field="o.net_wage"
                              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']" position="replace">
            <div id="payslip_lines_table"/>
        </xpath>

