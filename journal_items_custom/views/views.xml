<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="view_move_line_form_custom" model="ir.ui.view">
            <field name="name">account_move_line-form_custom</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_id']" position="before">
                    <field name="account_invisible" invisible="1" column_invisble="1"/>
                </xpath>
                <xpath expr="//field[@name='account_id']" position="attributes">
                    <attribute name="readonly">account_invisible</attribute>
                </xpath>
            </field>
        </record>

