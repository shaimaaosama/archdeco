<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="group_gs_product_brand">
                <field name="name">Brand</field>
                <field name="sequence">0</field>
        </record>

        <record id="group_gs_product_brand_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="group_gs_product_brand"/>
        </record>

        <record id="group_gs_product_brand_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="group_gs_product_brand"/>
            <field name="implied_ids" eval="[(4, ref('group_gs_product_brand_user'))]"/>
        </record>
        
    </data>
</odoo>