<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="readonly">True</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']//list//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_tag_id" optional="hide"/>
                    <field name="product_tag_id" optional="hide" options="{'no_create': True, 'no_create_edit': True,}"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_tag_id" optional="hide"/>
                    <field name="product_tag_id" optional="hide" options="{'no_create': True, 'no_create_edit': True,}"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree_inherit" model="ir.ui.view">
            <field name="name">account.move.line.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="branch_distribution_note" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_tag_id" optional="hide"/>
                    <field name="product_tag_id" optional="hide" options="{'no_create': True, 'no_create_edit': True,}"/>
                    <field name="budget_group_id" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>