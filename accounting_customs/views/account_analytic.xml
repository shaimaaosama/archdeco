<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_analytic_account_form_inherit" model="ir.ui.view">
            <field name="name">account.analytic.account.form.inherit</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Branch Distribution">
                        <field name="branch_distribution_line_ids" context="{'default_analytic_account_id': id}">
                            <list editable="bottom">
                                <field name="branch_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="percentage"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_account_analytic_account_list_inherit" model="ir.ui.view">
            <field name="name">account.analytic.account.list.inherit</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="branch_distribution"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_analytic_account_search_inherit" model="ir.ui.view">
            <field name="name">account.analytic.account.search.inherit</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='associatedpartner']" position="after">
                    <filter string="Branch Distribution" name="branch_distribution" domain="[]" context="{'group_by': 'branch_distribution'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>