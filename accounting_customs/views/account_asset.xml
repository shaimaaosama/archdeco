<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_asset_tree_inherit" model="ir.ui.view">
            <field name="name">account.asset.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="analytic_distribution" widget="analytic_distribution" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='original_value']" position="attributes">
                    <attribute name="sum">Total</attribute>
                </xpath>
                <xpath expr="//field[@name='book_value']" position="attributes">
                    <attribute name="sum">Total</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>