<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListView.Buttons" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'o_list_buttons')]" position="inside">
            <button t-if="isBudgetDashboardMoveLineAction"
                    type="button"
                    class="btn budget_back_button"
                    t-on-click="onBackToBudgetDashboard">
                ← Back to Budget
            </button>
        </xpath>

    </t>

</templates>