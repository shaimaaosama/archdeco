<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_mobile" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pt.employee.mobile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="Mobile App" name="pt_employee_mobile_setting_container">
                    <setting string="Company Geofence" company_dependent="1"
                             help="Used for employees whose mobile attendance location is set to Company.">
                        <div class="o_row">
                            <field name="attendance_latitude" placeholder="Latitude"/>
                            <field name="attendance_longitude" placeholder="Longitude"/>
                        </div>
                        <div class="o_row">
                            <span class="me-2">Radius</span>
                            <field name="attendance_radius" class="text-center" style="width: 6ch;"/>
                            <span class="ms-2">meters</span>
                        </div>
                    </setting>
                    <setting string="Late Grace Period" company_dependent="1"
                              help="Minutes of tolerance after the scheduled start time before a mobile check-in is marked late.">
                        <field name="mobile_late_grace_minutes" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">minutes</span>
                    </setting>
                    <setting string="Block Mock Locations" company_dependent="1"
                              help="Reject mobile app check-in/check-out when the device reports a mocked GPS location.">
                        <field name="mobile_block_mock_location"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_mobile" model="ir.ui.view">
        <field name="name">res.company.form.mobile.app</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Mobile App" name="pt_employee_mobile">
                    <group>
                        <group string="Geofence">
                            <field name="attendance_latitude"/>
                            <field name="attendance_longitude"/>
                            <field name="attendance_radius"/>
                        </group>
                        <group string="Attendance">
                            <field name="mobile_late_grace_minutes"/>
                            <field name="mobile_block_mock_location"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
