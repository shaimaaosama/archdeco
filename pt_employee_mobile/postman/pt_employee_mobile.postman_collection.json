{
  "info": {
    "_postman_id": "120c10bd-6f24-40be-95c9-b375229954e9",
    "name": "ArchDeco Employee Mobile API",
    "description": "pt_employee_mobile REST API (see API.md). Run **Auth > Login** first: it stores the bearer token in the `token` collection variable, used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8018"
    },
    {
      "key": "lang",
      "value": "en"
    },
    {
      "key": "email",
      "value": "employee@example.com"
    },
    {
      "key": "pin",
      "value": "1234"
    },
    {
      "key": "new_pin",
      "value": "4321"
    },
    {
      "key": "latitude",
      "value": "24.7136"
    },
    {
      "key": "longitude",
      "value": "46.6753"
    },
    {
      "key": "month",
      "value": "2026-09"
    },
    {
      "key": "year",
      "value": "2026"
    },
    {
      "key": "payslip_id",
      "value": "1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/ping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "ping"
              ]
            },
            "description": "Health check, no auth.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "login"
              ]
            },
            "description": "Work email + hr.employee PIN. Saves data.token into {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"pin\": \"{{pin}}\",\n  \"device\": {\n    \"id\": \"postman-1\",\n    \"name\": \"Postman\",\n    \"platform\": \"android\",\n    \"app_version\": \"1.0.0\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('login ok', () => pm.expect(j.success).to.eql(true));",
                  "if (j.success) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  console.log('token saved, expires', j.data.expires_at);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "profile"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/change-pin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "change-pin"
              ]
            },
            "description": "New PIN 4-8 digits. Revokes all other sessions. Remember to update {{pin}} afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_pin\": \"{{pin}}\",\n  \"new_pin\": \"{{new_pin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "logout"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    },
