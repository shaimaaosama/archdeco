    {
      "name": "Payslips",
      "item": [
        {
          "name": "Payslips List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/payslips?year={{year}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "payslips"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "{{year}}"
                }
              ]
            },
            "description": "Only done/paid payslips. Stores the first id into {{payslip_id}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('success envelope', () => pm.expect(j.success).to.eql(true));",
                  "if (j.success && j.data.payslips.length) {",
                  "  pm.collectionVariables.set('payslip_id', j.data.payslips[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
