              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard returns employee and permissions payload', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('employee_id');",
                  "  pm.expect(body).to.have.property('permissions');",
                  "  pm.expect(body.permissions).to.have.property('require_face_attendance');",
                  "});",
                  "var dashboard = pm.response.json();",
                  "if (dashboard && dashboard.employee_id) {",
                  "  pm.collectionVariables.set('employee_id', dashboard.employee_id);",
                  "}",
                  "if (dashboard && dashboard.permissions) {",
                  "  pm.collectionVariables.set('require_face_attendance', String(Boolean(dashboard.permissions.require_face_attendance)));",
                  "}"
                ]
              }
