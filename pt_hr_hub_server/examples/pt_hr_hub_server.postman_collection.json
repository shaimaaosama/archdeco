{
  "info": {
    "_postman_id": "7ad20610-7f7a-4e5e-84f6-2f8de7e2f2a1",
    "name": "PT HR Hub Server - MuK REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for pt_hr_hub_server and core MuK REST flows using HTTP Basic authentication only.\n\nHow to use:\n1) Set the collection or environment variables: base_url, user_login, user_password.\n2) Basic authentication is configured at collection level and inherited by all requests.\n3) Optional variables are provided for employee, expense, meeting, and payslip examples."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{user_login}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{user_password}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Hub Attendance Endpoint",
      "item": [
        {
          "name": "Create Attendance via pt_hr_hub_server",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": {{employee_id}},\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"faceio_id\": \"{{faceio_id}}\",\n  \"lat\": {{geofence_latitude}},\n  \"long\": {{geofence_longitude}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/hr_hub/attendance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v2",
                "hr_hub",
                "attendance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hub attendance created', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Attendance response contains success and attendance_id', function () {",
                  "  pm.expect(body).to.have.property('success', true);",
                  "  pm.expect(body).to.have.property('attendance_id');",
                  "});",
                  "if (body && body.attendance_id) {",
                  "  pm.collectionVariables.set('attendance_id', body.attendance_id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
