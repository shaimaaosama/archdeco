<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="before">
                <filter domain="[('state','=', 'revised')]" name="revised" string="Revise Quotations"/>
            </xpath></field>
    </record>
    <record id="act_action_sale_order_revised" model="ir.actions.act_window">
        <field name="name">Revised Sale Order Quotation</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="domain">[('parent_saleorder_id', '=', active_id)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Revised Sale Order.
            </p></field>
    </record>
    <record id="sale_order_inherited_view_quotation_revision" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button class="btn-primary" name="so_revision_quote" string="Approval RS" type="object"/>
                <button class="btn-primary" invisible="state not in ['revised']" name="set_so" string="Set SO" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <!--                <button class="oe_inline oe_stat_button" type="action"
                                    name="%(act_action_sale_order_revised)d" icon="fa-bars"
                                    > &lt;!&ndash;attrs="{'invisible':[('state','in',('revised'))]}"&ndash;&gt;
                                    <field string="Revised Orders Quotation" name="order_revised_count"
                                        widget="statinfo" />
                                </button>-->
                <button class="oe_inline oe_stat_button" icon="fa-bars" name="act_action_sale_order_revised2" type="object">
                    <field name="order_count" string="Revised Orders Quotation" widget="statinfo"/>
                </button>
                <button class="oe_inline oe_stat_button" icon="fa-bars" name="act_action_sale_order_revised" type="object">
                    <field name="sale_order_count" string="Sale Orders" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field invisible="1" name="is_new"/>
                <field invisible="1" name="char_name"/>
                <field invisible="1" name="so_number"/>
                <field invisible="1" name="parent_saleorder_id"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="revised_ref_id" readonly="1"/>
            </xpath></field>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[(1, '=', 1)]</field>
    </record>
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[(1, '=', 1)]</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain">[(1, '=', 1)]</field>
    </record>
    <!--    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'revised')]</field>
    </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'revised')]</field>
    </record>

    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'revised')]</field>
    </record>-->
</odoo>
